<Window x:Class="Viora.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Viora — Roblox Workspace" UseLayoutRounding="True" SnapsToDevicePixels="True" Width="1240" Height="840"
        Background="{DynamicResource Bg}" Closing="Window_Closing" StateChanged="Window_StateChanged"
        MinWidth="1060" MinHeight="810" WindowStartupLocation="CenterScreen">
    <Grid Background="{DynamicResource Bg}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,14,12,16">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Margin="8,4,6,15">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/Viora-logo.png" Width="32" Height="32" Margin="0,0,8,0"/>
                            <TextBlock Text="Viora" FontWeight="SemiBold" FontSize="22" Foreground="{DynamicResource Fg}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Your Roblox workspace" FontSize="11" Foreground="{DynamicResource Muted}" Margin="4,4,0,0"/>
                    </StackPanel>
                    <TextBlock Text="YOUR SPACE" Margin="16,0,0,11" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/>
                    <Button x:Name="NavDashboard" Content="⌂   Overview" Style="{StaticResource NavButton}" Click="NavDashboard_Click"/>
                    <Button x:Name="NavGroupOptimize" Style="{StaticResource NavButton}" Click="NavGroupOptimize_Click">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="▤   Optimise" VerticalAlignment="Center"/>
                            <TextBlock x:Name="NavOptimizeArrow" Grid.Column="1" Text="⌄" FontSize="16"
                                       Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="7,0,0,0"/>
                        </Grid>
                    </Button>
                    <StackPanel x:Name="GroupOptimizeChildren" Visibility="Collapsed" Margin="12,0,0,6">
                        <Button x:Name="NavPerformance" Content="↗   Performance" Style="{StaticResource NavSubButton}" Click="NavPerformance_Click"/>
                        <Button x:Name="NavFlags" Content="◇   FastFlags" Style="{StaticResource NavSubButton}" Click="NavFlags_Click"/>
                    </StackPanel>
                    <Button x:Name="NavGroupWorkspace" Style="{StaticResource NavButton}" Click="NavGroupWorkspace_Click">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="▧   Workspace" VerticalAlignment="Center"/>
                            <TextBlock x:Name="NavWorkspaceArrow" Grid.Column="1" Text="⌄" FontSize="16"
                                       Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="7,0,0,0"/>
                        </Grid>
                    </Button>
                    <StackPanel x:Name="GroupWorkspaceChildren" Visibility="Collapsed" Margin="12,0,0,6">
                        <Button x:Name="NavProfiles" Content="▧   Profiles" Style="{StaticResource NavSubButton}" Click="NavProfiles_Click"/>
                        <Button x:Name="NavLauncher" Content="↗   Quick Launcher" Style="{StaticResource NavSubButton}" Click="NavLauncher_Click"/>
                        <Button x:Name="NavMods" Content="◈   Asset Studio" Style="{StaticResource NavSubButton}" Click="NavMods_Click"/>
                    </StackPanel>
                    <Button x:Name="NavGroupActivity" Style="{StaticResource NavButton}" Click="NavGroupActivity_Click">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="◷   Activity" VerticalAlignment="Center"/>
                            <TextBlock x:Name="NavActivityArrow" Grid.Column="1" Text="⌄" FontSize="16"
                                       Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="7,0,0,0"/>
                        </Grid>
                    </Button>
                    <StackPanel x:Name="GroupActivityChildren" Visibility="Collapsed" Margin="12,0,0,6">
                        <Button x:Name="NavGameHub" Content="♧   Game Hub" Style="{StaticResource NavSubButton}" Click="NavGameHub_Click"/>
                        <Button x:Name="NavStats" Content="◷   Statistics" Style="{StaticResource NavSubButton}" Click="NavStats_Click"/>
                        <Button x:Name="NavDiscord" Content="◎   Discord Presence" Style="{StaticResource NavSubButton}" Click="NavDiscord_Click"/>
                    </StackPanel>
                    <Button x:Name="NavGroupPersonalize" Style="{StaticResource NavButton}" Click="NavGroupPersonalize_Click">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="✦   Personalise" VerticalAlignment="Center"/>
                            <TextBlock x:Name="NavPersonalizeArrow" Grid.Column="1" Text="⌄" FontSize="16"
                                       Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="7,0,0,0"/>
                        </Grid>
                    </Button>
                    <StackPanel x:Name="GroupPersonalizeChildren" Visibility="Collapsed" Margin="12,0,0,6">
                        <Button x:Name="NavAppearance" Content="✦   Appearance" Style="{StaticResource NavSubButton}" Click="NavAppearance_Click"/>
                        <Button x:Name="NavSplash" Content="✧   Splash Screen" Style="{StaticResource NavSubButton}" Click="NavSplash_Click"/>
                        <Button x:Name="NavTools" Content="⚙   Utilities" Style="{StaticResource NavSubButton}" Click="NavTools_Click"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Margin="7,20,7,0">
                    <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="12" Padding="13">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Ellipse Width="37" Height="37" Stroke="{DynamicResource Accent}" StrokeThickness="1.5" Margin="0,0,10,0" x:Name="SidebarAvatar"/>
                                <TextBlock Text="ACCOUNT" Foreground="{DynamicResource Muted}" FontSize="10" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="SidebarAccountLabel" Text="●  Local account" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>

                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="FooterVersionText" Text="VIORA" FontSize="10" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                    <Button Content="Report an issue" Click="ReportIssue_Click" Margin="0,10,0,0" FontSize="11" ToolTip="Review a report before opening GitHub Issues"/>
                    <Button Content="Sign out" Click="SignOut_Click" Margin="0,7,0,0" FontSize="11"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="34,24,34,18">
            <Grid.RowDefinitions><RowDefinition Height="75"/><RowDefinition Height="*"/><RowDefinition Height="35"/></Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="PERSONAL ROBLOX COMPANION" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="Bold"/>
                    <TextBlock x:Name="PageHeading" Text="Overview" FontSize="27" FontWeight="SemiBold" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="ROBLOX INSTALLATION" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,0,0,4"/>
                    <ComboBox x:Name="InstallationCombo" SelectionChanged="InstallationCombo_SelectionChanged"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1">
                <!-- Dashboard -->
                <ScrollViewer x:Name="DashboardPage" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,8,10,18">
                        <Border CornerRadius="16" Padding="26" Background="{DynamicResource PanelRaised}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="YOUR SPACE" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
                                    <TextBlock x:Name="GreetingText" Text="Hello! Ready to play?" FontWeight="SemiBold" FontSize="26" Margin="0,9,0,0"/>
                                    <TextBlock Text="Roblox launch, optimisation and activity tools in one workspace." Margin="0,8,0,22" Foreground="{DynamicResource Muted}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="▶  Launch Roblox" Style="{StaticResource PrimaryButton}" Click="Launch_Click" Margin="0,0,10,0"/>
                                        <Button Content="Apply current profile" Click="ApplyProfile_Click" Margin="0,0,10,0"/>
                                        <Button Content="↗  Performance" Click="GoPerformance_Click"/>
                                        <Button Content="◷  My stats" Click="GoStats_Click" Margin="10,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Column="1" VerticalAlignment="Center" Width="82" Height="82" CornerRadius="22" Background="{DynamicResource AccentSoft}" Margin="16,0,0,0">
                                    <Grid>
                                        <Ellipse x:Name="DashboardAvatar" Stroke="{DynamicResource Accent}" StrokeThickness="2" Margin="5"/>
                                        <Image x:Name="DashboardAvatarFallback" Source="/Assets/Viora-logo.png" Width="66" Height="66" Stretch="Uniform"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                        <UniformGrid Columns="3" Margin="0,16,0,16">
                            <Border Style="{StaticResource PanelBorder}" Margin="0,0,12,0">
                                <StackPanel><TextBlock Text="ROBLOX INSTALLATION" Style="{StaticResource Hint}" FontSize="10"/>
                                    <TextBlock x:Name="DashClientStatus" Text="Checking..." FontSize="19" FontWeight="SemiBold" Margin="0,11,0,4"/>
                                    <TextBlock x:Name="DashClientVersion" Style="{StaticResource Hint}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PanelBorder}" Margin="0,0,12,0">
                                <StackPanel><TextBlock Text="ACTIVE PROFILE" Style="{StaticResource Hint}" FontSize="10"/>
                                    <TextBlock x:Name="DashProfileName" Text="Default" FontSize="19" FontWeight="SemiBold" Margin="0,11,0,4"/>
                                    <TextBlock Text="Saved profile configuration" Style="{StaticResource Hint}" FontSize="11"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PanelBorder}">
                                <StackPanel><TextBlock Text="CONFIGURED FLAGS" Style="{StaticResource Hint}" FontSize="10"/>
                                    <TextBlock x:Name="DashFlagCount" Text="0" FontSize="19" FontWeight="SemiBold" Margin="0,11,0,4"/>
                                    <TextBlock Text="Allowlisted snapshot only" Style="{StaticResource Hint}" FontSize="11"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <Button Content="Open Game Activity Hub  ↗" DockPanel.Dock="Right" Click="NavGameHub_Click"/>
                                    <TextBlock Text="Game activity" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </DockPanel>
                                <UniformGrid Columns="3" Margin="0,0,0,12">
                                    <StackPanel><TextBlock Text="TODAY" Style="{StaticResource Hint}" FontSize="10"/><TextBlock x:Name="HomeTodayTime" Text="0m" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/></StackPanel>
                                    <StackPanel><TextBlock Text="GAMES IDENTIFIED" Style="{StaticResource Hint}" FontSize="10"/><TextBlock x:Name="HomeGamesCount" Text="0" FontSize="21" FontWeight="SemiBold"/></StackPanel>
                                    <StackPanel><TextBlock Text="MOST PLAYED" Style="{StaticResource Hint}" FontSize="10"/><TextBlock x:Name="HomeTopGameName" Text="No data yet" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></StackPanel>
                                </UniformGrid>
                                <TextBlock Text="TOP GAMES  ·  OBSERVED IN VIORA" Style="{StaticResource Hint}" FontSize="10" Margin="0,4,0,9"/>
                                <ItemsControl x:Name="HomeTopGamesList">
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <Border Background="{DynamicResource PanelRaised}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="9" Padding="9" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="39"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <Border Background="{DynamicResource AccentSoft}" CornerRadius="7" Width="36" Height="36">
                                                    <Grid><TextBlock Text="◇" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Accent}" FontSize="22"/>
                                                        <Image Source="{Binding Icon}" Stretch="Uniform"/></Grid>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" Margin="11,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="2" Text="{Binding PlaytimeLabel}" VerticalAlignment="Center" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelBorder}">
                            <StackPanel>
                                <TextBlock Text="Quick startup tools" FontWeight="SemiBold" FontSize="17" Margin="0,0,0,7"/>
                                <TextBlock Text="Shortcuts for frequently used settings and launching Roblox." Style="{StaticResource Hint}" Margin="0,0,0,16"/>
                                <WrapPanel>
                                    <Button Content="Explore FastFlags  ↗" Click="GoFlags_Click" Margin="0,0,10,10"/>
                                    <Button Content="FPS presets  ↗" Click="GoPerformance_Click" Margin="0,0,10,10"/>
                                    <Button Content="My profiles  ↗" Click="GoProfiles_Click" Margin="0,0,10,10"/>
                                    <Button Content="Launch Roblox  ▶" Style="{StaticResource PrimaryButton}" Click="Launch_Click" Margin="0,0,10,10"/>
                                    <Button Content="Discord Presence  ↗" Click="NavDiscord_Click" Margin="0,0,10,10"/>
                                    <Button Content="My appearance  ↗" Click="NavAppearance_Click" Margin="0,0,10,10"/>
                                </WrapPanel>
                                <TextBlock x:Name="DashboardActivityText" Text="No Roblox session currently detected." Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                                <TextBlock x:Name="DashboardGameText" Text="" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
                <!-- v0.6 Game Activity Hub: game detection is local and best-effort. -->
                <ScrollViewer x:Name="GameHubPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Margin="0,8,0,10">
                    <StackPanel Margin="0,0,10,18">
                        <Border Background="{DynamicResource PanelRaised}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="16" Padding="24" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="YOUR GAME ACTIVITY" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" FontSize="10"/>
                                <TextBlock Text="Game library and activity" FontSize="25" FontWeight="SemiBold" Margin="0,9,0,5"/>
                                <TextBlock Text="Playtime per Roblox place is observed while Viora is open and Roblox logs identify the game. Earlier version totals can't be attributed retroactively." Style="{StaticResource Hint}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <UniformGrid Columns="3" Margin="0,0,0,16">
                            <Border Style="{StaticResource PanelBorder}" Margin="0,0,8,0"><StackPanel>
                                <TextBlock Text="GAMES SEEN" Style="{StaticResource Hint}" FontSize="10"/>
                                <TextBlock x:Name="GameHubCount" Text="0" FontSize="23" FontWeight="SemiBold" Margin="0,9,0,0"/>
                            </StackPanel></Border>
                            <Border Style="{StaticResource PanelBorder}" Margin="0,0,8,0"><StackPanel>
                                <TextBlock Text="GAME TIME IDENTIFIED" Style="{StaticResource Hint}" FontSize="10"/>
                                <TextBlock x:Name="GameHubTracked" Text="0m" FontSize="23" FontWeight="SemiBold" Margin="0,9,0,0"/>
                            </StackPanel></Border>
                            <Border Style="{StaticResource PanelBorder}"><StackPanel>
                                <TextBlock Text="RECENT SESSIONS" Style="{StaticResource Hint}" FontSize="10"/>
                                <TextBlock x:Name="GameHubRecentCount" Text="0" FontSize="23" FontWeight="SemiBold" Margin="0,9,0,0"/>
                            </StackPanel></Border>
                        </UniformGrid>
                        <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,13">
                                    <TextBlock Text="Most played games" FontSize="18" FontWeight="SemiBold" DockPanel.Dock="Left"/>
                                    <TextBlock Text="Sorted by observed time" Style="{StaticResource Hint}" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <TextBox x:Name="GameSearchBox" TextChanged="GameSearch_Changed" Margin="0,0,0,8"
                                         ToolTip="Search by game name or place ID"/>
                                <WrapPanel Margin="0,0,0,9">
                                    <ComboBox x:Name="GameHubSortCombo" SelectedIndex="0" SelectionChanged="GameHubSort_Changed" Width="176" Margin="0,0,12,7">
                                        <ComboBoxItem Content="Most played"/>
                                        <ComboBoxItem Content="Recently played"/>
                                        <ComboBoxItem Content="Name (A–Z)"/>
                                    </ComboBox>

                                </WrapPanel>
                                <TextBlock x:Name="GameHubTrackingStatus" Text="○ Roblox closed · tracking paused" Foreground="{DynamicResource Accent}" FontSize="12" Margin="0,0,0,8"/>
                                <TextBlock Text="Select a game for charts and session insights. Stats reflect time observed by Viora only." Style="{StaticResource Hint}" FontSize="11" Margin="0,0,0,12"/>
                                <ListBox x:Name="GameHubGamesGrid" Background="Transparent" BorderThickness="0"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         SelectionMode="Single" SelectionChanged="GameHubSelection_Changed" MaxHeight="530" MinHeight="198">
                                    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,9,10"/>
                                            <Setter Property="Background" Value="{DynamicResource PanelRaised}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Template">
                                                <Setter.Value><ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="CardOutline" CornerRadius="12" Padding="10" Background="{TemplateBinding Background}"
                                                            BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="CardOutline" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="CardOutline" Property="BorderThickness" Value="2"/></Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CardOutline" Property="Background" Value="{DynamicResource AccentSoft}"/></Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate><DataTemplate>
                                        <StackPanel Width="171">
                                            <Border Width="171" Height="111" Background="{DynamicResource Panel}" CornerRadius="9" ClipToBounds="True">
                                                <Grid>
                                                    <TextBlock Text="◇" FontSize="50" Foreground="{DynamicResource AccentSoft}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    <Image Source="{Binding Icon}" Stretch="Uniform"/>
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold" Margin="2,10,2,6" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding DisplayName}"/>
                                            <TextBlock Text="{Binding PlaytimeLabel}" Foreground="{DynamicResource Accent}" FontSize="12" Margin="2,0,2,0"/>
                                            <TextBlock Text="{Binding Sessions, StringFormat={}{0} sessions}" Foreground="{DynamicResource Muted}" FontSize="10" Margin="2,4,0,0"/>
                                        </StackPanel>
                                    </DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="▶  Open game page" Style="{StaticResource PrimaryButton}" Click="OpenSelectedGame_Click" Margin="0,0,9,9"/>
                                    <Button Content="Copy official link" Click="CopySelectedGameLink_Click" Margin="0,0,9,9"/>
                                    <Button Content="Export game history CSV" Click="ExportGameHistory_Click" Margin="0,0,9,9"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource PanelBorder}">
                                <StackPanel>
                                    <TextBlock Text="Quick Launcher" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,9"/>
                                    <TextBlock Text="Save Roblox game links and assign launch profiles in Workspace → Quick Launcher." 
                                               Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                    <TextBlock Text="Game Hub is now focused on game activity, session history and playtime. Use Quick Launcher for saved game links."
                                               Style="{StaticResource Hint}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource PanelBorder}"><StackPanel>
                                <TextBlock Text="Selected game" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,9"/>
                                <Grid Margin="0,2,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Width="82" Height="82" CornerRadius="10" Background="{DynamicResource PanelRaised}" ClipToBounds="True" HorizontalAlignment="Left">
                                        <Grid><TextBlock Text="◇" FontSize="32" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image x:Name="GameHubSelectedImage" Stretch="UniformToFill"/></Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="GameHubSelectedName" Text="Select a game above" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="GameHubSelectedDescription" Style="{StaticResource Hint}" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="11"/>
                                    </StackPanel>
                                </Grid>
                                <UniformGrid Columns="2" Margin="0,0,0,12">
                                    <Border Background="{DynamicResource PanelRaised}" CornerRadius="9" Padding="11" Margin="0,0,6,0">
                                        <StackPanel><TextBlock Text="OBSERVED TIME" Style="{StaticResource Hint}" FontSize="9"/><TextBlock x:Name="GameHubSelectedTime" Text="0m" Foreground="{DynamicResource Accent}" FontSize="18" Margin="0,5,0,0"/></StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource PanelRaised}" CornerRadius="9" Padding="11">
                                        <StackPanel><TextBlock Text="SESSIONS" Style="{StaticResource Hint}" FontSize="9"/><TextBlock x:Name="GameHubSelectedSessionCount" Text="0" Foreground="{DynamicResource Accent}" FontSize="18" Margin="0,5,0,0"/></StackPanel>
                                    </Border>
                                </UniformGrid>
                                <UniformGrid Columns="2" Margin="0,0,0,11">
                                    <Border Background="{DynamicResource PanelRaised}" CornerRadius="9" Padding="11" Margin="0,0,6,0"><StackPanel>
                                        <TextBlock Text="AVERAGE SESSION (APPROX.)" Style="{StaticResource Hint}" FontSize="9"/>
                                        <TextBlock x:Name="GameHubAverageSession" Text="0m" Foreground="{DynamicResource Accent}" FontSize="18" Margin="0,5,0,0"/>
                                    </StackPanel></Border>
                                    <Border Background="{DynamicResource PanelRaised}" CornerRadius="9" Padding="11"><StackPanel>
                                        <TextBlock Text="LONGEST SAVED SESSION" Style="{StaticResource Hint}" FontSize="9"/>
                                        <TextBlock x:Name="GameHubLongestSession" Text="—" Foreground="{DynamicResource Accent}" FontSize="18" Margin="0,5,0,0"/>
                                    </StackPanel></Border>
                                </UniformGrid>
                                <DockPanel Margin="0,0,0,5">
                                    <ComboBox x:Name="GameHubRangeCombo" DockPanel.Dock="Right" Width="114" HorizontalAlignment="Right" SelectedIndex="0" SelectionChanged="GameHubRange_Changed">
                                        <ComboBoxItem Content="7 days"/><ComboBoxItem Content="30 days"/>
                                    </ComboBox>
                                    <StackPanel>
                                        <TextBlock x:Name="GameHubRangeCaption" Text="LAST 7 DAYS  ·  OBSERVED TIME" Style="{StaticResource Hint}" FontSize="10"/>
                                        <TextBlock x:Name="GameHubRangeTotal" Text="0m" Foreground="{DynamicResource Accent}" FontSize="15" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,3">
                                    <StackPanel x:Name="GameHubDailyBars" Orientation="Horizontal" Height="125" Margin="0,10,0,0"/>
                                </ScrollViewer>
                                <TextBlock Text="RECENT SESSIONS IN THIS GAME" Style="{StaticResource Hint}" FontSize="10" Margin="0,16,0,8"/>
                                <ItemsControl x:Name="GameHubSelectedRecentSessions">
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <Border Background="{DynamicResource PanelRaised}" CornerRadius="6" Padding="8,7" Margin="0,0,0,5">
                                            <DockPanel><TextBlock Text="{Binding DurationLabel}" DockPanel.Dock="Right" Foreground="{DynamicResource Accent}"/>
                                                <TextBlock Text="{Binding StartedLabel}" Foreground="{DynamicResource Muted}"/></DockPanel>
                                        </Border>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel></Border>
                        </Grid>
                        <Border Style="{StaticResource PanelBorder}"><StackPanel>
                            <TextBlock Text="Recent game sessions" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock Text="Tracked from v0.6 onwards. If Roblox never publishes a detectable place ID, the time remains in total Roblox playtime but not here." Style="{StaticResource Hint}" Margin="0,0,0,12" TextWrapping="Wrap"/>
                            <DataGrid x:Name="GameHubRecentGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" MaxHeight="230" MinHeight="100">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="GAME" Binding="{Binding DisplayName}" Width="*"/>
                                    <DataGridTextColumn Header="STARTED" Binding="{Binding StartedLabel}" Width="135"/>
                                    <DataGridTextColumn Header="TIME" Binding="{Binding DurationLabel}" Width="105"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel></Border>
                    </StackPanel>
                </ScrollViewer>
                <!-- Stats: measured locally only while Viora runs -->
                <ScrollViewer x:Name="StatsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Margin="0,8,0,10">
                    <StackPanel Margin="0,0,10,18">
                        <Border Background="{DynamicResource PanelRaised}" CornerRadius="16" Padding="26" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="YOUR ACTIVITY" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="Roblox, in numbers." FontSize="25" FontWeight="SemiBold" Margin="0,8,0,8"/>
                                <TextBlock Text="Private statistics saved on this PC. Tracking works while Viora is open, including in the background." Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </Border>
                        <UniformGrid Columns="3" Margin="0,0,0,16">
                            <Border Style="{StaticResource PanelBorder}" Margin="0,0,10,0"><StackPanel>
                                <TextBlock Text="TODAY" Style="{StaticResource Hint}" FontSize="10"/>
                                <TextBlock x:Name="StatsToday" Text="0m" FontSize="25" FontWeight="SemiBold" Margin="0,6,0,0"/>
                            </StackPanel></Border>
                            <Border Style="{StaticResource PanelBorder}" Margin="0,0,10,0"><StackPanel>
                                <TextBlock Text="PAST 7 DAYS" Style="{StaticResource Hint}" FontSize="10"/>
                                <TextBlock x:Name="StatsThisWeek" Text="0m" FontSize="25" FontWeight="SemiBold" Margin="0,6,0,0"/>
                            </StackPanel></Border>
                            <Border Style="{StaticResource PanelBorder}"><StackPanel>
                                <TextBlock Text="DAYS WITH ACTIVITY IN A ROW" Style="{StaticResource Hint}" FontSize="10"/>
                                <TextBlock x:Name="StatsStreak" Text="0" FontSize="25" FontWeight="SemiBold" Margin="0,6,0,0"/>
                            </StackPanel></Border>
                        </UniformGrid>
                        <UniformGrid Columns="2" Margin="0,0,0,16">
                            <Border Style="{StaticResource PanelBorder}" Margin="0,0,8,10">
                                <StackPanel><TextBlock Text="OBSERVED PLAYTIME" Style="{StaticResource Hint}" FontSize="11"/>
                                    <TextBlock x:Name="StatsPlaytime" Text="0m" FontSize="30" FontWeight="SemiBold" Margin="0,10,0,4"/>
                                    <TextBlock Text="Time with Roblox running and Viora monitoring" Style="{StaticResource Hint}" FontSize="11"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PanelBorder}" Margin="8,0,0,10">
                                <StackPanel><TextBlock Text="ROBLOX SESSIONS SEEN" Style="{StaticResource Hint}" FontSize="11"/>
                                    <TextBlock x:Name="StatsSessions" Text="0" FontSize="30" FontWeight="SemiBold" Margin="0,10,0,4"/>
                                    <TextBlock Text="Separate running periods seen by this app" Style="{StaticResource Hint}" FontSize="11"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PanelBorder}" Margin="0,0,8,0">
                                <StackPanel><TextBlock Text="LAUNCH BUTTON PRESSES" Style="{StaticResource Hint}" FontSize="11"/>
                                    <TextBlock x:Name="StatsLaunches" Text="0" FontSize="30" FontWeight="SemiBold" Margin="0,10,0,4"/>
                                    <TextBlock Text="Successful requests to open the official launcher" Style="{StaticResource Hint}" FontSize="11"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PanelBorder}" Margin="8,0,0,0">
                                <StackPanel><TextBlock Text="LONGEST OBSERVED SESSION" Style="{StaticResource Hint}" FontSize="11"/>
                                    <TextBlock x:Name="StatsLongest" Text="0m" FontSize="30" FontWeight="SemiBold" Margin="0,10,0,4"/>
                                    <TextBlock Text="Only the portion recorded while Viora was open" Style="{StaticResource Hint}" FontSize="11"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,5">
                                    <ComboBox x:Name="StatsRangeCombo" DockPanel.Dock="Right" Width="150" SelectionChanged="StatsRange_Changed" SelectedIndex="0">
                                        <ComboBoxItem Content="Last 7 days" Tag="7"/>
                                        <ComboBoxItem Content="Last 30 days" Tag="30"/>
                                    </ComboBox>
                                    <TextBlock Text="Playtime activity" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="17"/>
                                </DockPanel>
                                <TextBlock Text="Observed Roblox runtime per local day, measured only while Viora is open." Style="{StaticResource Hint}" Margin="0,0,0,15"/>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="StatsWeekBars" Orientation="Horizontal" HorizontalAlignment="Left" Height="132"/>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelBorder}">
                            <StackPanel>
                                <TextBlock Text="Session status" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock x:Name="StatsCurrentSession" Text="Roblox is not currently detected." Foreground="{DynamicResource Accent}" Margin="0,10,0,12"/>
                                <TextBlock x:Name="StatsLastSeen" Style="{StaticResource Hint}" Margin="0,0,0,14"/>
                                <TextBlock Text="Statistics reflect only locally observed sessions, not full Roblox account history. Monitoring pauses when Viora closes; a session already underway may be counted as a new observation." Style="{StaticResource Hint}" FontSize="11" Margin="0,0,0,14"/>
                                <WrapPanel>
                                    <Button Content="Export statistics CSV" Style="{StaticResource PrimaryButton}" Click="ExportStats_Click" Margin="0,0,10,0"/>
                                    <Button Content="Reset my statistics" Click="ResetStats_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelBorder}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Recent completed sessions" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,7"/>
                                <TextBlock Text="Recorded from v0.5 onward, not historical Roblox account data. Most recent 250 sessions are saved locally." Style="{StaticResource Hint}" Margin="0,0,0,12"/>
                                <DataGrid x:Name="StatsSessionsGrid" Height="240" ItemsSource="{Binding}" HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="STARTED" Binding="{Binding StartedLocal}" Width="1.5*"/>
                                        <DataGridTextColumn Header="DURATION" Binding="{Binding DurationLabel}" Width="1*"/>
                                        <DataGridTextColumn Header="EXPERIENCE" Binding="{Binding ExperienceLabel}" Width="2*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <!-- Performance: documented FPS options and conservative, reversible flag presets -->
                <ScrollViewer x:Name="PerformancePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Margin="0,8,0,10">
                    <StackPanel Margin="0,0,10,16">
                        <Border Background="{DynamicResource PanelRaised}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="16" Padding="24" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="PERFORMANCE CENTER" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="SemiBold"/>
                                <TextBlock Text="Graphics and performance" FontSize="24" FontWeight="SemiBold" Margin="0,9,0,8"/>
                                <TextBlock Text="Performance presets with change summaries and restore options. Results vary by device and experience." Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="Rendering presets" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBlock Text="Optional rendering presets for the active profile. Flag effects depend on Roblox client support; FPS caps are managed independently." Style="{StaticResource Hint}" Margin="0,0,0,17"/>
                                <TextBlock Text="PRESET" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="SemiBold"/>
                                <ComboBox x:Name="PerformancePresetCombo" Margin="0,8,0,14" SelectionChanged="PerformancePresetCombo_SelectionChanged" SelectedIndex="0">
                                    <ComboBoxItem Content="Maximum performance (experimental)" Tag="max"/>
                                    <ComboBoxItem Content="Balanced graphics (experimental)" Tag="balanced"/>
                                    <ComboBoxItem Content="Roblox defaults" Tag="default"/>
                                </ComboBox>
                                <TextBlock x:Name="PerformancePresetPreview" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,16"/>
                                <CheckBox x:Name="PerfGrassToggle" IsChecked="False" Content="Reduced grass draw distance (experimental)" Margin="0,0,0,14" Checked="PerfGrassToggle_Changed" Unchecked="PerfGrassToggle_Changed"/>
                                <WrapPanel>
                                    <Button Content="Save and apply preset" Style="{StaticResource PrimaryButton}" Click="ApplyPerformancePreset_Click" Margin="0,0,10,9"/>
                                    <Button Content="Clear performance overrides" Click="ClearPerformanceOverrides_Click" Margin="0,0,10,9"/>
                                </WrapPanel>
                                <TextBlock x:Name="PerformanceActiveText" Style="{StaticResource Hint}" FontSize="11" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="Frame rate and graphics" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,9"/>
                                <TextBlock Text="Saved Roblox Player preferences for frame rate and graphics quality. Settings apply while Roblox is closed; client updates may reset them." Style="{StaticResource Hint}" Margin="0,0,0,15"/>
                                <Grid Margin="0,0,0,13">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="MAXIMUM FRAME RATE" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,7"/>
                                        <ComboBox x:Name="PerfFpsCombo" SelectedIndex="0">
                                            <ComboBoxItem Content="60 FPS" Tag="60"/>
                                            <ComboBoxItem Content="120 FPS" Tag="120"/>
                                            <ComboBoxItem Content="144 FPS" Tag="144"/>
                                            <ComboBoxItem Content="165 FPS" Tag="165"/>
                                            <ComboBoxItem Content="240 FPS" Tag="240"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="GRAPHICS QUALITY" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,7"/>
                                        <ComboBox x:Name="PerfQualityCombo" SelectedIndex="0">
                                            <ComboBoxItem Content="Automatic (Roblox chooses)" Tag="0"/>
                                            <ComboBoxItem Content="Level 1 · fastest" Tag="1"/>
                                            <ComboBoxItem Content="Level 2" Tag="2"/>
                                            <ComboBoxItem Content="Level 3" Tag="3"/>
                                            <ComboBoxItem Content="Level 4" Tag="4"/>
                                            <ComboBoxItem Content="Level 5 · balanced" Tag="5"/>
                                            <ComboBoxItem Content="Level 6" Tag="6"/>
                                            <ComboBoxItem Content="Level 7" Tag="7"/>
                                            <ComboBoxItem Content="Level 8" Tag="8"/>
                                            <ComboBoxItem Content="Level 9" Tag="9"/>
                                            <ComboBoxItem Content="Level 10 · best quality" Tag="10"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="PerfSettingsStatus" Text="Checking saved Roblox settings..." Style="{StaticResource Hint}" FontSize="12" Margin="0,0,0,13"/>
                                <WrapPanel>
                                    <Button Content="Apply graphics settings" Style="{StaticResource PrimaryButton}" Click="ApplyRobloxGraphics_Click" Margin="0,0,10,9"/>
                                    <Button Content="Reload from Roblox" Click="ReloadRobloxGraphics_Click" Margin="0,0,10,9"/>
                                    <Button Content="Restore previous values" Click="RestoreRobloxGraphics_Click" Margin="0,0,10,9"/>
                                </WrapPanel>
                                <TextBlock Text="Viora backs up the file and only restores the specific settings it changes. FPS above 240 is not offered because Roblox does not officially support it. Choosing a cap does not guarantee the PC can reach it." Style="{StaticResource Hint}" FontSize="11" Margin="0,7,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="Windows performance options" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,9"/>
                                <TextBlock Text="Optional Windows performance controls. The linked system panels remain responsible for driver, power and operating-system preferences." Style="{StaticResource Hint}" Margin="0,0,0,14"/>
                                <WrapPanel>
                                    <Button Content="Windows Game Mode ↗" Click="OpenGameMode_Click" Margin="0,0,10,9"/>
                                    <Button Content="Graphics preferences ↗" Click="OpenWindowsGraphics_Click" Margin="0,0,10,9"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelBorder}">
                            <StackPanel>
                                <TextBlock Text="Performance information" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,9"/>
                                <TextBlock Text="Frame rate and frame-time statistics are available through Roblox's built-in performance display (Shift + F5). Lower graphics settings may help some systems, but hardware limits and experience complexity affect results." Style="{StaticResource Hint}" Margin="0,0,0,12"/>
                                <TextBlock Text="Previous graphics values and Viora-managed FastFlags are reversible through the restore controls." Style="{StaticResource Hint}" FontSize="11"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <!-- FastFlag Explorer -->
                <Grid x:Name="FlagsPage" Visibility="Collapsed" Margin="0,8,0,10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Explore the 2025 published allowlist with explanations and editable values, or sync a larger public reference list. Unlisted reference flags are informational only." Style="{StaticResource Hint}" Margin="0,0,0,14"/>
                    <Grid Grid.Row="1" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="FlagSearchBox" TextChanged="FlagFilter_Changed" VerticalContentAlignment="Center" ToolTip="Search by name, description, or category"/>
                        <ComboBox x:Name="FlagCategoryFilter" Grid.Column="1" Margin="12,0,12,0" SelectionChanged="FlagCategoryFilter_Changed"/>
                        <CheckBox x:Name="SupportedOnly" Grid.Column="2" Content="Published only" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0" Checked="FlagSupportedOnly_Changed" Unchecked="FlagSupportedOnly_Changed"/>
                        <CheckBox x:Name="FlagConfiguredOnly" Grid.Column="3" Content="My flags" VerticalAlignment="Center" Checked="FlagConfiguredOnly_Changed" Unchecked="FlagConfiguredOnly_Changed"/>
                    </Grid>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.65*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource PanelBorder}" Padding="0" ClipToBounds="True">
                            <DataGrid x:Name="FlagsGrid" SelectionChanged="FlagsGrid_SelectionChanged" AlternationCount="2">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="FASTFLAG" Binding="{Binding Name}" Width="2.9*"/>
                                    <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" Width="1.15*"/>
                                    <DataGridTextColumn Header="TYPE" Binding="{Binding Type}" Width="0.8*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock x:Name="FlagResultCount" Text="Find flags by name or purpose" Style="{StaticResource Hint}" Margin="0,0,0,9"/>
                                    <TextBlock Text="FLAG DETAILS" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock x:Name="FlagDetailName" Text="Select a FastFlag" TextWrapping="Wrap" FontSize="17" FontWeight="Bold" Margin="0,10,0,8"/>
                                    <TextBlock x:Name="FlagDetailStatus" Style="{StaticResource Hint}" FontSize="11" Margin="0,0,0,16"/>
                                    <TextBlock Text="WHAT IT DOES" FontSize="10" Foreground="{DynamicResource Accent}" FontWeight="Bold"/>
                                    <TextBlock x:Name="FlagDetailDescription" Text="Choose an entry to see an explanation." TextWrapping="Wrap" Margin="0,7,0,18"/>
                                    <TextBlock Text="EXPLANATION RELIABILITY" FontSize="10" Foreground="{DynamicResource Accent}" FontWeight="Bold"/>
                                    <TextBlock x:Name="FlagDetailConfidence" Style="{StaticResource Hint}" Margin="0,5,0,17"/>
                                    <TextBlock Text="WARNING" FontSize="10" Foreground="{DynamicResource Accent}" FontWeight="Bold"/>
                                    <TextBlock x:Name="FlagDetailWarning" TextWrapping="Wrap" Style="{StaticResource Hint}" Margin="0,7,0,18"/>
                                    <TextBlock Text="VALUE (TRUE / FALSE OR INTEGER)" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="Bold"/>
                                    <TextBox x:Name="FlagValueBox" Margin="0,8,0,5"/>
                                    <ComboBox x:Name="FlagBooleanValue" Visibility="Collapsed" Margin="0,8,0,5">
                                        <ComboBoxItem Content="On / True" Tag="True"/>
                                        <ComboBoxItem Content="Off / False" Tag="False"/>
                                    </ComboBox>
                                    <TextBlock x:Name="FlagExampleValue" Text="" Style="{StaticResource Hint}" FontSize="10" Margin="0,0,0,15"/>
                                    <Button x:Name="SaveFlagButton" Content="Add / update in profile" Style="{StaticResource PrimaryButton}" Click="SaveFlag_Click" Margin="0,0,0,9"/>
                                    <Button x:Name="RemoveFlagButton" Content="Remove from profile" Click="RemoveFlag_Click"/>
                                    <TextBlock Text="Changes are saved to the selected profile. Supported values can be applied when Roblox is closed." Style="{StaticResource Hint}" FontSize="11" Margin="0,12,0,0"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                    <WrapPanel Grid.Row="3" Margin="0,14,0,0">
                        <Button Content="Clear search" Click="ClearFlagSearch_Click" Margin="0,0,8,7"/>
                        <Button Content="Sync public flag names ↻" Click="SyncPublicCatalog_Click" Margin="0,0,8,7"/>
                        <Button Content="Import flags JSON" Click="ImportFlags_Click" Margin="0,0,8,7"/>
                        <Button Content="Export active flags" Click="ExportFlags_Click" Margin="0,0,8,0"/>
                        <Button Content="Import reference catalogue" Click="ImportCatalog_Click" Margin="0,0,8,0"/>
                        <Button Content="Official Roblox allowlist ↗" Click="OpenAllowlist_Click"/>
                    </WrapPanel>
                </Grid>
                <!-- Profiles -->
                <Grid x:Name="ProfilesPage" Visibility="Collapsed" Margin="0,8,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="1.25*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource PanelBorder}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Saved profiles" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>
                            <ListBox x:Name="ProfileList" SelectionChanged="ProfileList_SelectionChanged" DisplayMemberPath="Name" Padding="8" FontSize="15"/>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
                        <StackPanel>
                            <TextBlock Text="Manage profiles" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                            <TextBlock Text="Profiles maintain independent FastFlag configurations without overwriting previous settings." Style="{StaticResource Hint}" Margin="0,0,0,24"/>
                            <TextBlock Text="PROFILE NAME" FontSize="10" Foreground="{DynamicResource Accent}" FontWeight="Bold"/>
                            <TextBox x:Name="ProfileNameBox" Margin="0,8,0,14"/>
                            <WrapPanel>
                                <Button Content="Create profile" Style="{StaticResource PrimaryButton}" Click="CreateProfile_Click" Margin="0,0,9,9"/>
                                <Button Content="Duplicate selected" Click="DuplicateProfile_Click" Margin="0,0,9,9"/>
                                <Button Content="Delete selected" Click="DeleteProfile_Click" Margin="0,0,9,9"/>
                            </WrapPanel>
                            <Button Content="Make selected profile active" Style="{StaticResource PrimaryButton}" Click="ActivateProfile_Click" Margin="0,10,0,0"/>
                            <Border Background="{DynamicResource PanelRaised}" CornerRadius="10" Padding="15" Margin="0,30,0,0">
                                <StackPanel><TextBlock x:Name="ProfileDetailTitle" Text="" FontWeight="Bold"/>
                                    <TextBlock x:Name="ProfileDetailCount" Style="{StaticResource Hint}" Margin="0,7,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
                <!-- Asset Studio -->
                <ScrollViewer x:Name="ModsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Margin="0,8,0,10">
                    <StackPanel>
                        <TextBlock Text="Optional local texture, sound and font replacements require an existing asset in the client content directory. Originals are backed up before replacement." Style="{StaticResource Hint}" Margin="0,0,0,16"/>
                        <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Stage a new asset" FontSize="18" FontWeight="Bold" Margin="0,0,0,17"/>
                                <TextBlock Text="SOURCE FILE" Foreground="{DynamicResource Accent}" FontWeight="Bold" FontSize="10"/>
                                <Grid Margin="0,7,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="AssetSourceBox" IsReadOnly="True" VerticalContentAlignment="Center"/>
                                    <Button Grid.Column="1" Content="Browse..." Click="BrowseAsset_Click" Margin="10,0,0,0"/>
                                </Grid>
                                <TextBlock Text="TARGET PATH RELATIVE TO ROBLOX VERSION FOLDER" Foreground="{DynamicResource Accent}" FontWeight="Bold" FontSize="10"/>
                                <TextBox x:Name="AssetTargetBox" Text="content/sounds/ouch.ogg" Margin="0,7,0,7"/>
                                <TextBlock Text="The path must begin with content/ and refer to an existing file. Source and target extensions must match." Style="{StaticResource Hint}" FontSize="11" Margin="0,0,0,16"/>
                                <Button Content="+  Stage asset" Style="{StaticResource PrimaryButton}" Click="StageAsset_Click" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelBorder}">
                            <StackPanel>
                                <TextBlock Text="Staged assets" FontWeight="Bold" FontSize="18" Margin="0,0,0,13"/>
                                <ListBox x:Name="ModList" SelectionChanged="ModList_SelectionChanged" DisplayMemberPath="RelativeTarget" Height="155"/>
                                <CheckBox x:Name="SelectedModEnabled" Style="{StaticResource SwitchCheckBox}" Content="Enable selected asset" Foreground="{DynamicResource Fg}" Margin="0,14,0,15" Checked="SelectedModEnabled_Changed" Unchecked="SelectedModEnabled_Changed"/>
                                <WrapPanel>
                                    <Button Content="Apply enabled assets" Style="{StaticResource PrimaryButton}" Click="ApplyAssets_Click" Margin="0,0,9,9"/>
                                    <Button Content="Restore originals" Click="RestoreAssets_Click" Margin="0,0,9,9"/>
                                    <Button Content="Remove from staged list" Click="DeleteMod_Click" Margin="0,0,9,9"/>
                                </WrapPanel>
                                <TextBlock Text="Roblox updates may overwrite modified resources. Restore original assets before deleting staged replacements." Style="{StaticResource Hint}" FontSize="11" Margin="0,9,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <!-- Utilities -->
                <!-- Discord presence: OFF by default, no OAuth tokens or account logins. -->
                <ScrollViewer x:Name="DiscordPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Margin="0,8,0,10">
                    <StackPanel Margin="0,0,10,18">
                        <Border Background="{DynamicResource PanelRaised}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="16" Padding="24" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="DISCORD INTEGRATION" Foreground="{DynamicResource Accent}" FontWeight="Bold" FontSize="10"/>
                                <TextBlock Text="Discord activity settings" FontSize="24" FontWeight="SemiBold" Margin="0,10,0,8"/>
                                <TextBlock Text="Optional Discord Rich Presence for detected experiences, session time and idle status." Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Live preview" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,15"/>
                                <Border Background="#241C36" CornerRadius="12" Padding="18">
                                    <StackPanel>
                                        <TextBlock Text="◆  Viora" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
                                        <TextBlock x:Name="DiscordPreviewDetails" Text="Not active" FontSize="15" Margin="0,12,0,5"/>
                                        <TextBlock x:Name="DiscordPreviewState" Text="Enable Rich Presence below" Style="{StaticResource Hint}"/>
                                        <TextBlock x:Name="DiscordPreviewTime" Text="" Foreground="{DynamicResource Accent}" FontSize="11" Margin="0,7,0,0"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="DiscordConnectionStatus" Text="Disabled" TextWrapping="Wrap" Style="{StaticResource Hint}" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="01   Connect Discord" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <CheckBox x:Name="DiscordEnabled" Style="{StaticResource SwitchCheckBox}" Content="Enable Discord Rich Presence" Margin="0,0,0,16"/>
                                <TextBlock Text="DISCORD APPLICATION ID" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="Bold"/>
                                <TextBox x:Name="DiscordApplicationId" Margin="0,7,0,9" MaxLength="32"/>
                                <TextBlock Text="Create a free app at discord.com/developers/applications, then paste its Application ID (not a token or secret). Keep Discord desktop open." Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,13"/>
                                <Button Content="Open Discord Developer Portal  ↗" Click="OpenDiscordPortal_Click" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="02   Activity display" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,13"/>
                                <CheckBox x:Name="DiscordShowGame" Style="{StaticResource SwitchCheckBox}" Content="Show detected Roblox experience names (may not work in every session)" Margin="0,0,0,12"/>
                                <TextBlock Text="MANUAL EXPERIENCE NAME (OPTIONAL)" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="Bold"/>
                                <TextBox x:Name="DiscordManualGame" Margin="0,7,0,5" MaxLength="100"/>
                                <TextBlock Text="Leave empty for automatic detection. Use this when Roblox changes its log format or the game API is unavailable." Style="{StaticResource Hint}" Margin="0,0,0,16"/>
                                <CheckBox x:Name="DiscordShowAfk" Style="{StaticResource SwitchCheckBox}" Content="Show AFK after no Windows keyboard/mouse input" Margin="0,0,0,12"/>
                                <TextBlock Text="AFK THRESHOLD" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="Bold"/>
                                <ComboBox x:Name="DiscordIdleMinutes" Margin="0,7,0,14" Width="220" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="After 2 minutes" Tag="2"/>
                                    <ComboBoxItem Content="After 5 minutes" Tag="5"/>
                                    <ComboBoxItem Content="After 10 minutes" Tag="10"/>
                                    <ComboBoxItem Content="After 15 minutes" Tag="15"/>
                                </ComboBox>
                                <TextBlock Text="CUSTOM AFK TEXT" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="Bold"/>
                                <TextBox x:Name="DiscordIdleLabel" Margin="0,7,0,14" MaxLength="90"/>
                                <CheckBox x:Name="DiscordShowBrowsing" Style="{StaticResource SwitchCheckBox}" Content="Detect browsing Roblox from the current browser window title (optional)" Margin="0,0,0,12"/>
                                <TextBlock Text="Only checks the active Chrome, Edge, Firefox, Brave or Opera window title for ‘Roblox’. No URL, history, cookies or tab scanning. May miss some pages." Style="{StaticResource Hint}" Margin="0,0,0,12"/>
                                <CheckBox x:Name="DiscordShowClosed" Style="{StaticResource SwitchCheckBox}" Content="Show 'Roblox closed' / Viora idle activity when not playing" Margin="0,0,0,16"/>
                                <TextBlock Text="OPTIONAL LARGE IMAGE ASSET KEY" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="Bold"/>
                                <TextBox x:Name="DiscordImageKey" Margin="0,7,0,8" MaxLength="120"/>
                                <TextBlock Text="Use an image asset configured in the Discord Developer Portal. Leave empty to hide the large image." Style="{StaticResource Hint}" Margin="0,0,0,15"/>
                                <WrapPanel>
                                    <Button Content="Save and connect" Style="{StaticResource PrimaryButton}" Click="SaveDiscord_Click" Margin="0,0,10,8"/>
                                    <Button Content="Turn off and clear presence" Click="DisableDiscord_Click" Margin="0,0,10,8"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelBorder}">
                            <StackPanel>
                                <TextBlock Text="Privacy and compatibility" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="0,0,0,9"/>
                                <TextBlock Text="Detection uses local Roblox Player logs and, optionally, the public game-name API. Discord activity is visible according to Discord privacy settings. No account passwords, cookies or private server IDs are required. Tracking operates while Viora is running; Roblox updates may affect log detection." Style="{StaticResource Hint}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelBorder}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Game-specific Discord Presence" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,9"/>
                                <TextBlock Text="Set a different Discord presence for each detected game. Overrides are opt-in; AFK still takes priority and hidden game names stay hidden." Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,13"/>
                                <ComboBox x:Name="DiscordPerGameCombo" DisplayMemberPath="DisplayName" SelectionChanged="DiscordPerGameSelection_Changed" Margin="0,0,0,10"/>
                                <CheckBox x:Name="DiscordPerGameEnabled" Content="Use custom presence for this game" Style="{StaticResource SwitchCheckBox}" Checked="DiscordTemplateEnabled_Changed" Unchecked="DiscordTemplateEnabled_Changed" Margin="0,0,0,12"/>
                                <TextBlock Text="QUICK TEMPLATES" Style="{StaticResource Hint}" Margin="0,0,0,7"/>
                                <WrapPanel Margin="0,0,0,10">
                                    <Button Content="Playing" Tag="playing" Click="DiscordTemplatePreset_Click" Margin="0,0,8,7"/>
                                    <Button Content="Grinding" Tag="grinding" Click="DiscordTemplatePreset_Click" Margin="0,0,8,7"/>
                                    <Button Content="Exploring" Tag="exploring" Click="DiscordTemplatePreset_Click" Margin="0,0,8,7"/>
                                </WrapPanel>
                                <TextBlock Text="DETAILS (optional, use {game} for detected title)" Style="{StaticResource Hint}"/>
                                <TextBox x:Name="DiscordPerGameDetails" MaxLength="128" TextChanged="DiscordTemplateText_Changed" Margin="0,5,0,9"/>
                                <TextBlock Text="STATE TEXT (optional)" Style="{StaticResource Hint}"/>
                                <TextBox x:Name="DiscordPerGameState" MaxLength="128" TextChanged="DiscordTemplateText_Changed" Margin="0,5,0,9"/>
                                <TextBlock Text="DISCORD LARGE IMAGE ASSET KEY (optional)" Style="{StaticResource Hint}"/>
                                <TextBox x:Name="DiscordPerGameImage" MaxLength="128" Margin="0,5,0,13"/>
                                <Border Background="{DynamicResource PanelRaised}" CornerRadius="12" Padding="13" Margin="0,0,0,13">
                                    <StackPanel>
                                        <TextBlock Text="LIVE TEMPLATE PREVIEW" Style="{StaticResource Hint}" FontSize="10" Margin="0,0,0,8"/>
                                        <TextBlock x:Name="DiscordTemplatePreviewDetails" Text="Playing Roblox" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="DiscordTemplatePreviewState" Text="Playing" Style="{StaticResource Hint}" Margin="0,5,0,0"/>
                                        <TextBlock Text="Preview only. Save to apply; Discord may format text differently." Style="{StaticResource Hint}" FontSize="10" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>
                                <WrapPanel>
                                    <Button Content="Save game presence" Style="{StaticResource PrimaryButton}" Click="SaveGamePresence_Click" Margin="0,0,10,8"/>
                                    <Button Content="Reset this game" Click="ClearGamePresence_Click" Margin="0,0,10,8"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <!-- Appearance: optional local avatar, theme palette, animations -->
                <ScrollViewer x:Name="AppearancePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Margin="0,8,0,10">
                    <StackPanel Margin="0,0,10,18">
                        <Border Background="{DynamicResource PanelRaised}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="16" Padding="24" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="MAKE IT YOURS" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="Appearance and themes" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,6"/>
                                <TextBlock Text="Appearance settings are stored locally. Themes, avatars and animations do not modify the Roblox client." Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="01  Profile picture" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Ellipse x:Name="AppearanceAvatar" Width="78" Height="78" Stroke="{DynamicResource Accent}" StrokeThickness="2"/>
                                    <StackPanel Margin="18,8,0,0">
                                        <TextBlock Text="Displayed on dashboard and sidebar" FontWeight="SemiBold"/>
                                        <TextBlock Text="PNG or JPEG · max 5 MB; a private local copy is saved." Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock x:Name="AvatarStatusText" Style="{StaticResource Hint}" Margin="0,0,0,12"/>
                                <WrapPanel>
                                    <Button Content="Choose profile picture" Style="{StaticResource PrimaryButton}" Click="ChooseAvatar_Click" Margin="0,0,10,0"/>
                                    <Button Content="Reset picture" Click="ResetAvatar_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="02  Colour theme" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,9"/>
                                <TextBlock Text="Select an accent colour and matching navigation highlights. Changes preview instantly and save automatically." Style="{StaticResource Hint}" Margin="0,0,0,12"/>
                                <ComboBox x:Name="AppearanceThemeCombo" Width="270" HorizontalAlignment="Left" SelectionChanged="AppearanceTheme_Changed">
                                    <ComboBoxItem Content="Violet · signature purple" Tag="Violet"/>
                                    <ComboBoxItem Content="Amethyst · bright lavender" Tag="Amethyst"/>
                                    <ComboBoxItem Content="Midnight · electric blue" Tag="Midnight"/>
                                    <ComboBoxItem Content="Rose · soft pink" Tag="Rose"/>
                                    <ComboBoxItem Content="Emerald · mint green" Tag="Emerald"/>
                                    <ComboBoxItem Content="Custom · editable colours" Tag="Custom"/>
                                </ComboBox>
                                <TextBlock x:Name="ThemeDescription" Style="{StaticResource Hint}" Margin="0,12,0,14"/>
                                <TextBlock Text="Surface style" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,7"/>
                                <ComboBox x:Name="AppearanceStyleCombo" Width="270" HorizontalAlignment="Left" SelectionChanged="AppearanceStyle_Changed">
                                    <ComboBoxItem Content="Glossy · signature finish" Tag="Glossy"/>
                                    <ComboBoxItem Content="Opaque · solid surfaces" Tag="Opaque"/>
                                    <ComboBoxItem Content="Glass · layered translucency" Tag="Glass"/>
                                </ComboBox>
                                <TextBlock Text="Glass gives panels a translucent appearance over Viora's background; it does not make the Windows desktop visible through Viora." Style="{StaticResource Hint}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Custom theme studio" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="Set hex colours (#RRGGBB), preview them, then save the Custom theme. Invalid colours are rejected." Style="{StaticResource Hint}" Margin="0,8,0,13"/>
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,10,8"><TextBlock Text="Background" Style="{StaticResource Hint}"/><TextBox x:Name="ThemeBackground"/></StackPanel>
                                    <StackPanel Margin="0,0,0,8"><TextBlock Text="Sidebar" Style="{StaticResource Hint}"/><TextBox x:Name="ThemeSidebar"/></StackPanel>
                                    <StackPanel Margin="0,0,10,8"><TextBlock Text="Panels" Style="{StaticResource Hint}"/><TextBox x:Name="ThemePanel"/></StackPanel>
                                    <StackPanel Margin="0,0,0,8"><TextBlock Text="Accent / buttons" Style="{StaticResource Hint}"/><TextBox x:Name="ThemeAccent"/></StackPanel>
                                    <StackPanel Margin="0,0,10,8"><TextBlock Text="Borders" Style="{StaticResource Hint}"/><TextBox x:Name="ThemeBorder"/></StackPanel>
                                    <StackPanel Margin="0,0,0,8"><TextBlock Text="Muted text" Style="{StaticResource Hint}"/><TextBox x:Name="ThemeMuted"/></StackPanel>
                                </UniformGrid>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="Save &amp; preview custom theme" Style="{StaticResource PrimaryButton}" Click="ThemeSave_Click" Margin="0,0,8,0"/>
                                    <Button Content="Pick accent colour…" Click="ThemePickAccent_Click" Margin="0,0,8,0"/>
                                    <Button Content="Pick background…" Click="ThemePickBackground_Click" Margin="0,0,8,0"/>
                                    <Button Content="Export palette" Click="ThemeExport_Click" Margin="0,0,8,0"/>
                                    <Button Content="Import palette" Click="ThemeImport_Click" Margin="0,0,8,0"/>
                                    <Button Content="Reset custom colours" Click="ThemeReset_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="03  Motion" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,9"/>
                                <CheckBox x:Name="AppearanceReduceMotion" Style="{StaticResource SwitchCheckBox}" Content="Reduce motion (disable page fade animations)" Checked="ReduceMotion_Changed" Unchecked="ReduceMotion_Changed"/>
                                <TextBlock Text="Reduced motion disables page transitions and other optional interface animations." Style="{StaticResource Hint}" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelBorder}">
                            <StackPanel>
                                <TextBlock Text="04  Splash Screen" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <TextBlock Text="Compact forest splash by default; optional custom image and GIF styles." Style="{StaticResource Hint}" Margin="0,0,0,12"/>
                                <Button Content="Customise splash screen  ↗" Click="NavSplash_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <!-- v0.5.2: dedicated compact splash editor; all settings are local to Viora. -->
                <ScrollViewer x:Name="SplashPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Margin="0,8,0,10">
                    <Grid Margin="0,0,7,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="6*"/><ColumnDefinition Width="4*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                            <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Startup splash settings" FontWeight="SemiBold" FontSize="17"/>
                                    <TextBlock Text="The default opens full-screen. Custom images and GIFs retain the compact window. Roblox loading screens are unaffected." Style="{StaticResource Hint}" Margin="0,7,0,14"/>
                                    <CheckBox x:Name="SplashEnable" Style="{StaticResource SwitchCheckBox}" Content="Enable startup splash" Checked="SplashPreviewInput_Changed" Unchecked="SplashPreviewInput_Changed"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="01  Splash content" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,9"/>
                                    <TextBlock Text="DEFAULT, IMAGE OR ANIMATED GIF" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,7"/>
                                    <ComboBox x:Name="SplashMode" SelectionChanged="SplashPreviewInput_Changed" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="Default · full-screen forest" Tag="Default"/>
                                        <ComboBoxItem Content="Custom image (PNG / JPG)" Tag="Image"/>
                                        <ComboBoxItem Content="Custom animated GIF" Tag="Gif"/>
                                    </ComboBox>
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Content="Choose image / GIF…" Style="{StaticResource PrimaryButton}" Click="SplashChooseMedia_Click" Margin="0,0,10,8"/>
                                        <Button Content="Clear custom media" Click="SplashClearMedia_Click" Margin="0,0,0,8"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="SplashMediaLabel" Style="{StaticResource Hint}" FontSize="11" Text="Default Viora artwork" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="02  Size and timing" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12"/>
                                    <TextBlock Text="WINDOW SIZE" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,7"/>
                                    <ComboBox x:Name="SplashSize" SelectionChanged="SplashPreviewInput_Changed">
                                        <ComboBoxItem Content="Small · compact" Tag="Small"/>
                                        <ComboBoxItem Content="Medium" Tag="Medium"/>
                                        <ComboBoxItem Content="Large" Tag="Large"/>
                                    </ComboBox>
                                    <DockPanel Margin="0,14,0,5">
                                        <TextBlock Text="Duration" FontWeight="SemiBold" DockPanel.Dock="Left"/>
                                        <TextBlock x:Name="SplashDurationLabel" Text="2.0 seconds" Foreground="{DynamicResource Accent}" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <Slider x:Name="SplashDurationSlider" Minimum="0.5" Maximum="10" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="2" Margin="0,4,0,5" ValueChanged="SplashPreviewInput_Changed"
                                            AutomationProperties.Name="Splash duration in seconds"/>
                                    <DockPanel Margin="0,2,0,0">
                                        <TextBlock DockPanel.Dock="Left" Text="0.5s" Foreground="{DynamicResource Muted}" FontSize="10"/>
                                        <TextBlock Text="10s" HorizontalAlignment="Right" Foreground="{DynamicResource Muted}" FontSize="10"/>
                                    </DockPanel>
                                    <TextBlock Text="Preview duration matches the selected value. Short durations may end before a GIF completes." Style="{StaticResource Hint}" FontSize="11" Margin="0,7,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="03  Details" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,11"/>
                                    <CheckBox x:Name="SplashShowLogo" Style="{StaticResource SwitchCheckBox}" Content="Show Viora logo" Margin="0,0,0,10" Checked="SplashPreviewInput_Changed" Unchecked="SplashPreviewInput_Changed"/>
                                    <CheckBox x:Name="SplashShowText" Style="{StaticResource SwitchCheckBox}" Content="Show startup text" Margin="0,0,0,10" Checked="SplashPreviewInput_Changed" Unchecked="SplashPreviewInput_Changed"/>
                                    <CheckBox x:Name="SplashSkipRunning" Style="{StaticResource SwitchCheckBox}" Content="Skip when Roblox is already running" Checked="SplashPreviewInput_Changed" Unchecked="SplashPreviewInput_Changed"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="04  Background and motion" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
                                    <TextBlock Text="Optionally add a background behind the media and logo." Style="{StaticResource Hint}" Margin="0,0,0,9"/>
                                    <WrapPanel Margin="0,0,0,5">
                                        <Button Content="Choose background…" Click="SplashChooseBackground_Click" Margin="0,0,10,8"/>
                                        <Button Content="Remove background" Click="SplashClearBackground_Click" Margin="0,0,0,8"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="SplashBackgroundLabel" Text="Default dark background" Style="{StaticResource Hint}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,0,15"/>
                                    <CheckBox x:Name="SplashFade" Style="{StaticResource SwitchCheckBox}" Content="Fade in and out" Checked="SplashPreviewInput_Changed" Unchecked="SplashPreviewInput_Changed" Margin="0,0,0,11"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="FADE IN" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,0,0,6"/>
                                            <ComboBox x:Name="SplashFadeIn" SelectionChanged="SplashPreviewInput_Changed">
                                                <ComboBoxItem Content="150 ms" Tag="150"/><ComboBoxItem Content="300 ms" Tag="300"/><ComboBoxItem Content="500 ms" Tag="500"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="FADE OUT" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,0,0,6"/>
                                            <ComboBox x:Name="SplashFadeOut" SelectionChanged="SplashPreviewInput_Changed">
                                                <ComboBoxItem Content="150 ms" Tag="150"/><ComboBoxItem Content="300 ms" Tag="300"/><ComboBoxItem Content="500 ms" Tag="500"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <WrapPanel Margin="0,0,0,12">
                                <Button Content="Save splash settings" Style="{StaticResource PrimaryButton}" Click="SplashSave_Click" Margin="0,0,9,8"/>
                                <Button Content="Play preview" Click="SplashTest_Click" Margin="0,0,9,8"/>
                                <Button Content="Reset defaults" Click="SplashReset_Click" Margin="0,0,0,8"/>
                            </WrapPanel>
                            <TextBlock Text="Settings remain unsaved until Save is selected. Imported images and GIFs are copied into local application data." Style="{StaticResource Hint}" FontSize="11"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="12" Padding="16" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Live preview" FontWeight="SemiBold" FontSize="17"/>
                                <TextBlock Text="See the selected look before saving." Style="{StaticResource Hint}" FontSize="11" Margin="0,5,0,16"/>
                                <Border x:Name="SplashPreviewCard" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource Stroke}" Background="#100B1A" Padding="11">
                                    <Grid>
                                        <Border x:Name="SplashPreviewDefault" CornerRadius="10" Height="228" ClipToBounds="True" Visibility="Collapsed" Background="#0E0B1B">
                                            <Grid>
                                                <Image Source="/Assets/Viora-forest.jpg" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <Border Background="#350A061C"/>
                                                <TextBlock Text="V i o r a" FontSize="38" FontWeight="Bold"
                                                           TextOptions.TextRenderingMode="ClearType" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Foreground>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#F2E7FF" Offset="0"/>
                                                            <GradientStop Color="#DBC4F3" Offset="0.28"/>
                                                            <GradientStop Color="#AE83D9" Offset="0.78"/>
                                                            <GradientStop Color="#C5A2E6" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </TextBlock.Foreground>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                        <StackPanel x:Name="SplashPreviewCompact">
                                        <Border CornerRadius="10" Height="155" Background="#26133C" ClipToBounds="True">
                                            <Grid>
                                                <Image x:Name="SplashPreviewBackground" Stretch="UniformToFill"/>
                                                <Image x:Name="SplashPreviewImage" Stretch="UniformToFill"/>
                                                <Image x:Name="SplashPreviewBannerLogo" Source="/Assets/Viora-logo.png" Width="84" Height="84" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <StackPanel HorizontalAlignment="Center" Margin="0,16,0,10">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Image x:Name="SplashPreviewSmallLogo" Source="/Assets/Viora-logo.png" Width="25" Height="25" Margin="0,0,8,0"/>
                                                <TextBlock Text="Viora" FontWeight="SemiBold" FontSize="19" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock x:Name="SplashPreviewText" Text="Starting workspace…" HorizontalAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,7,0,0"/>
                                            <TextBlock Text="●  ●  ●" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" Margin="0,9,0,0" FontSize="10"/>
                                        </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="SplashPreviewInfo" Style="{StaticResource Hint}" Text="Small · 2.0 seconds · Default" Margin="0,12,0,0" FontSize="11"/>
                                <TextBlock Text="Preview reflects the selected mode. Both default and custom splashes open as compact windows." Style="{StaticResource Hint}" FontSize="11" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
                <!-- v1.3: Quick Launcher is independent from removed favourite controls. -->
                <ScrollViewer x:Name="LauncherPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Margin="0,8,0,10">
                    <StackPanel Margin="0,0,8,12">
                        <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Quick Launcher" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock Text="Save official experience URLs or place IDs, organise folders and assign launch profiles. Roblox must be closed before applying saved FastFlags or graphics settings." Style="{StaticResource Hint}" Margin="0,8,0,15"/>
                                <TextBlock Text="GAME NAME" Style="{StaticResource Hint}" FontSize="10"/>
                                <TextBox x:Name="QuickName" Margin="0,5,0,10" MaxLength="80"/>
                                <TextBlock Text="PLACE ID OR ROBLOX GAME URL" Style="{StaticResource Hint}" FontSize="10"/>
                                <TextBox x:Name="QuickPlace" Margin="0,5,0,10" MaxLength="400"/>
                                <TextBlock Text="GAME WORKSPACE (E.G. GAMES, SIMULATORS, OBBIES)" Style="{StaticResource Hint}" FontSize="10"/>
                                <TextBox x:Name="QuickFolder" Text="Games" Margin="0,5,0,12" MaxLength="40"/>
                                <WrapPanel>
                                    <Button Content="Save new game" Style="{StaticResource PrimaryButton}" Click="QuickSave_Click" Margin="0,0,8,8"/>
                                    <Button Content="Update selected" Click="QuickUpdate_Click" Margin="0,0,8,8"/>
                                    <Button Content="Remove selected" Click="QuickRemove_Click" Margin="0,0,8,8"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Game Workspaces Lite" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <TextBlock Text="Your existing folders are workspaces. Pick one to see its games, or set a new workspace name when saving a shortcut. Your profiles stay with each game."
                                           Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                <WrapPanel Margin="0,0,0,8">
                                    <ComboBox x:Name="QuickWorkspaceFilter" Width="205" Margin="0,0,10,8"
                                              SelectionChanged="QuickWorkspaceFilter_Changed"
                                              ToolTip="Only show games belonging to the selected workspace"/>
                                    <Button x:Name="QuickWorkspaceRename" Content="Rename workspace" Margin="0,0,10,8"
                                            Click="QuickWorkspaceRename_Click" ToolTip="Rename the selected group without changing any game settings"/>
                                    <TextBlock x:Name="QuickWorkspaceCount" Text="0 shown · 0 workspaces"
                                               Style="{StaticResource Hint}" Margin="0,6,0,8" VerticalAlignment="Center"/>
                                </WrapPanel>
                                <TextBlock Text="SAVED GAMES" Style="{StaticResource Hint}" FontSize="10" Margin="0,0,0,6"/>
                                <TextBox x:Name="QuickSearch" TextChanged="QuickSearch_Changed" Margin="0,0,0,10" ToolTip="Search names, workspace names and Roblox place IDs"/>
                                <ListBox x:Name="QuickList" Height="225" SelectionChanged="QuickList_SelectionChanged" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Stroke}">
                                    <ListBox.ItemTemplate><DataTemplate>
                                        <Border Padding="10" Margin="2" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Stroke}">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/><TextBlock Text="{Binding Caption}" Foreground="{DynamicResource Muted}" FontSize="11"/></StackPanel>
                                                <TextBlock Grid.Column="1" Text="↗" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                                <WrapPanel Margin="0,13,0,0">
                                    <Button Content="▶  Open selected game" Style="{StaticResource PrimaryButton}" Click="QuickLaunch_Click" Margin="0,0,8,8"/>
                                    <Button Content="Copy official game link" Click="QuickCopy_Click" Margin="0,0,8,8"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelBorder}">
                            <StackPanel>
                                <TextBlock Text="Game-specific performance profile" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="Assigned profiles apply before Roblox launches. Unsupported or rejected settings may revert to Roblox defaults." Style="{StaticResource Hint}" Margin="0,8,0,14"/>
                                <TextBlock Text="FASTFLAG PROFILE" Style="{StaticResource Hint}" FontSize="10"/>
                                <ComboBox x:Name="QuickProfile" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,5,0,12"/>
                                <TextBlock Text="FPS CAP" Style="{StaticResource Hint}" FontSize="10"/>
                                <ComboBox x:Name="QuickFps" SelectedValuePath="Tag" Margin="0,5,0,12">
                                    <ComboBoxItem Content="Keep current settings" Tag="0"/>
                                    <ComboBoxItem Content="60 FPS" Tag="60"/><ComboBoxItem Content="120 FPS" Tag="120"/>
                                    <ComboBoxItem Content="144 FPS" Tag="144"/><ComboBoxItem Content="165 FPS" Tag="165"/>
                                    <ComboBoxItem Content="240 FPS" Tag="240"/>
                                </ComboBox>
                                <TextBlock Text="GRAPHICS QUALITY" Style="{StaticResource Hint}" FontSize="10"/>
                                <ComboBox x:Name="QuickQuality" SelectedValuePath="Tag" Margin="0,5,0,12">
                                    <ComboBoxItem Content="Keep current settings" Tag="-1"/><ComboBoxItem Content="Automatic" Tag="0"/>
                                    <ComboBoxItem Content="1 · Lowest" Tag="1"/><ComboBoxItem Content="2" Tag="2"/><ComboBoxItem Content="3" Tag="3"/>
                                    <ComboBoxItem Content="4" Tag="4"/><ComboBoxItem Content="5" Tag="5"/><ComboBoxItem Content="6" Tag="6"/>
                                    <ComboBoxItem Content="7" Tag="7"/><ComboBoxItem Content="8" Tag="8"/><ComboBoxItem Content="9" Tag="9"/><ComboBoxItem Content="10 · Highest" Tag="10"/>
                                </ComboBox>
                                <Button Content="Save performance assignment" Style="{StaticResource PrimaryButton}" Click="QuickUpdate_Click" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="ToolsPage" Visibility="Collapsed" Margin="0,8,0,10" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Viora Manager" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="An optional companion application for monitoring official Roblox Player windows, memory usage and window layouts." Style="{StaticResource Hint}" Margin="0,8,0,12"/>
                                <Button Content="Open Viora Manager" Click="OpenVioraManager_Click" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Help, privacy &amp; safe diagnostics" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="Getting Started, local data information and a reviewed diagnostic report for troubleshooting. No report is uploaded automatically." Style="{StaticResource Hint}" Margin="0,8,0,12"/>
                                <WrapPanel>
                                    <Button Content="Getting Started tutorial" Click="GettingStarted_Click" Margin="0,0,9,8" Style="{StaticResource PrimaryButton}"/>
                                    <Button Content="Privacy &amp; diagnostics" Click="PrivacyGuide_Click" Margin="0,0,9,8"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="First-run setup" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="Reopen the initial setup wizard to review appearance, graphics preferences and Discord activity options." Style="{StaticResource Hint}" Margin="0,8,0,12"/>
                                <Button Content="Open setup wizard" Click="OpenSetupWizard_Click" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Viora updates" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="Update Launcher and optional Manager separately. Small downloads are selected when the required .NET Desktop Runtime is installed. SHA-256 verification, rollback and staged-file cleanup are included." Style="{StaticResource Hint}" Margin="0,8,0,12"/>
                                <TextBlock Text="GITHUB REPOSITORY (owner/repo)" Style="{StaticResource Hint}" FontSize="10"/>
                                <TextBox x:Name="UpdatesRepo" Margin="0,6,0,12" ToolTip="Example: balcony3232/Viora"/>
                                <CheckBox x:Name="UpdatesAtStartup" Content="Check for new versions on startup" Style="{StaticResource SwitchCheckBox}" Margin="0,0,0,12"/>
                                <CheckBox x:Name="UpdatesIncludeManager" Content="Also update Viora Manager (close Manager first)" Style="{StaticResource SwitchCheckBox}"
                                          Checked="UpdatesIncludeManager_Changed" Unchecked="UpdatesIncludeManager_Changed"
                                          IsEnabled="False" Margin="0,0,0,8"/>
                                <TextBlock x:Name="UpdatesPayloadInfo" Style="{StaticResource Hint}" TextWrapping="Wrap"
                                           Margin="0,0,0,12" Text="Check for updates to see available components and download sizes."/>
                                <WrapPanel>
                                    <Button Content="Save update settings" Click="UpdatesSave_Click" Margin="0,0,8,8"/>
                                    <Button Content="Check for updates" Style="{StaticResource PrimaryButton}" Click="UpdatesCheck_Click" Margin="0,0,8,8"/>
                                    <Button x:Name="UpdatesDownload" Content="Install update &amp; restart" IsEnabled="False" Click="UpdatesDownload_Click" Margin="0,0,8,8"/>
                                </WrapPanel>
                                <TextBlock x:Name="UpdatesResult" Text="Update status is shown here." Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Backup &amp; recovery centre" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="Export and restore local account settings, images and profiles. Backup ZIPs include the local password hash and must be kept private. Restores apply at next launch after creating a safety copy." Style="{StaticResource Hint}" Margin="0,8,0,12"/>
                                <WrapPanel>
                                    <Button Content="Create full local backup" Style="{StaticResource PrimaryButton}" Click="RecoveryExport_Click" Margin="0,0,8,8"/>
                                    <Button Content="Restore a backup ZIP" Click="RecoveryRestore_Click" Margin="0,0,8,8"/>
                                    <Button Content="Open recovery folder" Click="RecoveryOpen_Click" Margin="0,0,8,8"/>
                                </WrapPanel>
                                <TextBlock x:Name="RecoveryStatus" Style="{StaticResource Hint}" Text="No recovery operation pending." Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="System tray" FontSize="18" FontWeight="SemiBold"/>
                                <CheckBox x:Name="TrayEnabled" Content="Minimise Viora to the notification area" Style="{StaticResource SwitchCheckBox}" Checked="TraySetting_Changed" Unchecked="TraySetting_Changed" Margin="0,9,0,12"/>
                                <TextBlock Text="Session tracking and Discord Rich Presence can remain active while minimised to the system tray. The tray menu includes Open and Exit." Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Roblox &amp; update tools" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
                                <TextBlock Text="Check the live Roblox Windows Player version, or open the official Roblox installer. Viora does not patch or replace Roblox's updater." Style="{StaticResource Hint}" Margin="0,0,0,15"/>
                                <WrapPanel>
                                    <Button Content="Check published version" Click="CheckVersion_Click" Margin="0,0,10,9"/>
                                    <Button Content="Open client folder" Click="OpenClientFolder_Click" Margin="0,0,10,9"/>
                                    <Button Content="Official Roblox website ↗" Click="OpenRobloxWebsite_Click" Margin="0,0,10,9"/>
                                </WrapPanel>
                                <TextBlock x:Name="LatestVersionText" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Backup &amp; reset" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
                                <TextBlock Text="Export configuration or revert FastFlag entries modified by Viora for the selected client version." Style="{StaticResource Hint}" Margin="0,0,0,15"/>
                                <WrapPanel>
                                    <Button Content="Export complete config ZIP" Click="BackupConfig_Click" Margin="0,0,10,9"/>
                                    <Button Content="Undo Viora FastFlags" Click="UndoFlags_Click" Margin="0,0,10,9"/>
                                    <Button Content="Open app data folder" Click="OpenAppData_Click" Margin="0,0,10,9"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Custom launcher icon" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
                                <TextBlock Text="Choose an .ico image and generate a Windows desktop shortcut using that icon. This changes the shortcut, not Roblox's installed executable." Style="{StaticResource Hint}" Margin="0,0,0,15"/>
                                <TextBlock x:Name="CustomIconText" Text="No custom icon selected" Style="{StaticResource Hint}" Margin="0,0,0,11"/>
                                <WrapPanel>
                                    <Button Content="Choose .ico file" Click="ChooseIcon_Click" Margin="0,0,10,9"/>
                                    <Button Content="Create desktop shortcut" Style="{StaticResource PrimaryButton}" Click="CreateShortcut_Click" Margin="0,0,10,9"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Startup splash screen" FontSize="18" FontWeight="Bold" Margin="0,0,0,9"/>
                                <TextBlock Text="Choose an image or animated GIF and preview the new compact splash. This changes Viora's startup, not Roblox's own loading screen." Style="{StaticResource Hint}" Margin="0,0,0,14"/>
                                <Button Content="Open Splash Screen settings  ↗" Click="NavSplash_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelBorder}">
                            <StackPanel><TextBlock Text="Flag documentation" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="Built-in entries are based on Roblox's published September 2025 allowlist. It can change, and explanations marked 'name-based' are not confirmed API documentation. Imported reference flags are browse-only." Style="{StaticResource Hint}" Margin="0,10,0,14"/>
                                <Button Content="Read Roblox's announcement ↗" Click="OpenAllowlist_Click" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Ready." Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="LOCAL ONLY  ·  WINDOWS" FontSize="10" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
        <!-- Local account: never asks for a Roblox login. -->
        <Grid x:Name="AuthOverlay" Grid.ColumnSpan="2" Panel.ZIndex="30" Background="#0B0912" Visibility="Visible">
            <Border Background="#181222" BorderBrush="#433057" BorderThickness="1" CornerRadius="20" Width="440" Padding="36" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="◆  Viora" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="0,0,0,26"/>
                    <TextBlock x:Name="AuthTitle" Text="Create local account" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,9"/>
                    <TextBlock x:Name="AuthSubtitle" Text="One private profile on this Windows PC." Style="{StaticResource Hint}" Margin="0,0,0,24"/>
                    <TextBlock Text="USERNAME" FontSize="11" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"/>
                    <TextBox x:Name="AuthUsername" Margin="0,7,0,16" MaxLength="24"/>
                    <TextBlock Text="PASSWORD" FontSize="11" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"/>
                    <PasswordBox x:Name="AuthPassword" Margin="0,7,0,16" MaxLength="256"/>
                    <StackPanel x:Name="AuthConfirmPanel">
                        <TextBlock Text="CONFIRM PASSWORD" FontSize="11" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"/>
                        <PasswordBox x:Name="AuthConfirm" Margin="0,7,0,16" MaxLength="256"/>
                    </StackPanel>
                    <TextBlock Text="Local accounts require a password each time Viora starts. Guest mode is available only if no local account exists." Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,1,0,17"/>
                    <TextBlock x:Name="AuthError" Foreground="#FFB3C5" TextWrapping="Wrap" Margin="0,0,0,9"/>
                    <Button x:Name="AuthSubmit" Content="Create local account" Style="{StaticResource PrimaryButton}" Click="AuthSubmit_Click" Padding="14,12"/>
                    <Button x:Name="AuthGuest" Content="Continue without an account" Click="AuthGuest_Click" Margin="0,10,0,0" Padding="13,9"/>
                    <TextBlock Text="Guest mode saves settings locally without a password." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,9,0,0"/>
                    <TextBlock Text="Local authentication only, separate from Roblox. A salted password hash is stored on this PC; no online account or sync is created." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,22,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
