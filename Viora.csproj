<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Viora</AssemblyName>
    <Version>1.2.0</Version>
    <FileVersion>1.2.0.0</FileVersion>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <RootNamespace>Viora</RootNamespace>
    <ApplicationIcon>Assets\Viora.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- The optional manager is a separate WPF application, not source for the main EXE. -->
    <Compile Remove="VioraManager\**\*.cs" />
    <Page Remove="VioraManager\**\*.xaml" />
    <ApplicationDefinition Remove="VioraManager\**\*.xaml" />
    <None Remove="Assets\FlagCatalog.json" />
    <EmbeddedResource Include="Assets\FlagCatalog.json" />
    <Resource Include="Assets\Viora-logo.png" />
    <Resource Include="Assets\Viora-forest.jpg" />
  </ItemGroup>
</Project>
