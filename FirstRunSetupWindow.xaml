<Window x:Class="Viora.FirstRunSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Viora" Width="660" Height="535"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#0B0912" Foreground="#F3F1F8"
        ShowInTaskbar="False" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Margin="30,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="VIORA  /  FIRST RUN" Foreground="#B99BFA" FontSize="11" FontWeight="Bold"/>
            <TextBlock x:Name="StepTitle" Text="Welcome to Viora" FontWeight="SemiBold" FontSize="29" Margin="0,8,0,6"/>
            <TextBlock x:Name="StepSubtitle" Foreground="#ACA3BA" TextWrapping="Wrap" FontSize="13"/>
        </StackPanel>
        <Border Grid.Row="1" Background="#191425" BorderBrush="#423054" BorderThickness="1" CornerRadius="16" Padding="23">
            <Grid>
                <StackPanel x:Name="WelcomeStep">
                    <TextBlock Text="A personalised Roblox companion" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,15"/>
                    <TextBlock Text="Viora provides launch shortcuts, supported graphics preferences, session history and optional Discord Rich Presence." TextWrapping="Wrap" FontSize="14" Margin="0,0,0,18"/>
                    <TextBlock Text="Everything is stored on this Windows PC. No Roblox password or Discord token is required." Foreground="#ACA3BA" TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <TextBlock Text="The local account is optional. Guest mode can be used without a password." Foreground="#CDB5F8" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel x:Name="DetectionStep" Visibility="Collapsed">
                    <TextBlock Text="Roblox installation" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,15"/>
                    <TextBlock x:Name="RobloxDetectionSummary" Text="Checking installations…" TextWrapping="Wrap" Foreground="#D6C4EF" FontSize="14" Margin="0,0,0,14"/>
                    <TextBlock Text="Viora uses the official Roblox launcher. No client modifications are required for basic launch and activity tracking." TextWrapping="Wrap" Foreground="#ACA3BA" Margin="0,0,0,18"/>
                    <Button x:Name="RefreshRobloxButton" Content="Check again" Click="RefreshRobloxButton_Click"
                            HorizontalAlignment="Left" Padding="14,8"/>
                </StackPanel>
                <StackPanel x:Name="PreferencesStep" Visibility="Collapsed">
                    <TextBlock Text="Appearance" FontSize="15" FontWeight="SemiBold"/>
                    <ComboBox x:Name="ThemeChoice" Margin="0,9,0,20" SelectedIndex="0">
                        <ComboBoxItem Content="Violet (default)" Tag="Violet"/>
                        <ComboBoxItem Content="Amethyst" Tag="Amethyst"/>
                        <ComboBoxItem Content="Midnight" Tag="Midnight"/>
                        <ComboBoxItem Content="Rose" Tag="Rose"/>
                        <ComboBoxItem Content="Emerald" Tag="Emerald"/>
                    </ComboBox>
                    <TextBlock Text="Performance profile" FontSize="15" FontWeight="SemiBold"/>
                    <ComboBox x:Name="PerformanceChoice" Margin="0,9,0,10" SelectedIndex="0">
                        <ComboBoxItem Content="Keep Roblox defaults (recommended)" Tag="default"/>
                        <ComboBoxItem Content="Balanced (experimental)" Tag="balanced"/>
                        <ComboBoxItem Content="Maximum performance (experimental)" Tag="max"/>
                    </ComboBox>
                    <TextBlock Text="Experimental presets may be ignored after Roblox updates. Settings are saved as a profile; changes are not applied to Roblox during setup." TextWrapping="Wrap" Foreground="#ACA3BA" FontSize="11"/>
                </StackPanel>
                <StackPanel x:Name="PrivacyStep" Visibility="Collapsed">
                    <TextBlock Text="Activity &amp; privacy" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,15"/>
                    <CheckBox x:Name="DiscordChoice" Content="Enable Discord Rich Presence" IsChecked="False" Margin="0,0,0,12"/>
                    <TextBlock Text="Discord presence is off by default. Enabling this preference does not connect until a Discord Application ID has been configured in Viora." TextWrapping="Wrap" Foreground="#ACA3BA" Margin="0,0,0,20"/>
                    <TextBlock Text="Playtime is recorded locally only while Viora can observe Roblox. No usage analytics are sent to a Viora server." TextWrapping="Wrap" Foreground="#D6C4EF"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StepCount" Text="1 of 4" Foreground="#ACA3BA" VerticalAlignment="Center" FontSize="12"/>
            <Button x:Name="BackButton" Grid.Column="1" Content="Back" Click="BackButton_Click"
                    Margin="0,0,10,0" Width="92" IsEnabled="False"/>
            <Button x:Name="NextButton" Grid.Column="2" Content="Continue" Click="NextButton_Click"
                    Background="#AA7CF0" BorderThickness="0" FontWeight="SemiBold" Width="125"/>
        </Grid>
    </Grid>
</Window>