<Application x:Class="VioraManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
  <Application.Resources>
    <SolidColorBrush x:Key="AppBg" Color="#0D0915"/>
    <SolidColorBrush x:Key="Panel" Color="#1C142A"/>
    <SolidColorBrush x:Key="Stroke" Color="#423056"/>
    <SolidColorBrush x:Key="Muted" Color="#BAACCD"/>
    <SolidColorBrush x:Key="Accent" Color="#B18BFA"/>
    <Style TargetType="Window">
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="Background" Value="{StaticResource AppBg}"/>
      <Setter Property="Foreground" Value="#F1EBFF"/>
    </Style>
    <!-- Explicit text styling prevents the OS light theme from rendering dark text on purple cards. -->
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#F2EAFF"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#F5EFFF"/>
      <Setter Property="Background" Value="#36264B"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="14,11"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="9">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Opacity" Value="0.86"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Surface" Property="Opacity" Value="0.42"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Custom combo template keeps selection surfaces and popup menus dark on Windows 10/11. -->
    <Style TargetType="{x:Type ComboBox}">
      <Setter Property="Foreground" Value="#F1EAFF"/>
      <Setter Property="Background" Value="#2A1E3A"/>
      <Setter Property="BorderBrush" Value="#604775"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="MaxDropDownHeight" Value="260"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ComboBox}">
            <Grid>
              <Border x:Name="ComboSurface" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="7"/>
              <ToggleButton Focusable="False" ClickMode="Press" Background="Transparent" BorderThickness="0"
                            IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton"><ContentPresenter/></ControlTemplate>
                </ToggleButton.Template>
                <Grid>
                  <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                    ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                    Margin="10,0,27,0" VerticalAlignment="Center"
                                    IsHitTestVisible="False"/>
                  <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0"
                        Data="M 0 0 L 4 4 L 8 0" Stroke="#D0B2FA" StrokeThickness="1.6"/>
                </Grid>
              </ToggleButton>
              <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                     Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                <Border Background="#21172D" BorderBrush="#73548D" BorderThickness="1"
                        CornerRadius="7" Padding="3" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                        MinWidth="{Binding ActualWidth, ElementName=ComboSurface}">
                  <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                    <ItemsPresenter/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ComboSurface" Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="{x:Type ComboBoxItem}">
      <Setter Property="Foreground" Value="#F4EEFF"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ComboBoxItem}">
            <Border x:Name="ItemSurface" Background="Transparent" CornerRadius="5" Padding="10,7">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ItemSurface" Property="Background" Value="#48325D"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemSurface" Property="Background" Value="#523471"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="{x:Type TextBox}">
      <Setter Property="Background" Value="#241931"/>
      <Setter Property="Foreground" Value="#F5EDFF"/>
      <Setter Property="CaretBrush" Value="#F5EDFF"/>
      <Setter Property="BorderBrush" Value="#64477C"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="9,6"/>
    </Style>
  </Application.Resources>
</Application>