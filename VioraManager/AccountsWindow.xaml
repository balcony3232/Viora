<Window x:Class="VioraManager.AccountsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Viora Manager — Add Accounts"
        Width="900" Height="840" MinWidth="750" MinHeight="650"
        WindowStartupLocation="CenterOwner"
        Background="#0D0915" Foreground="#F2EAFF">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Your Roblox Accounts" Foreground="#C3A1FF"
                       FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="Sign in through Roblox. With official OAuth configured, Viora can automatically verify the real username, User ID, display name and avatar. Without OAuth, web login only saves the browser session."
                       Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Background="{StaticResource Panel}" Padding="15"
                CornerRadius="12" Margin="0,0,0,14">
            <StackPanel>
                <DockPanel Margin="0,0,0,9">
                    <Button x:Name="StartBrowserLoginButton" DockPanel.Dock="Right"
                            Content="＋ Add browser account" Click="StartBrowserLogin_Click"
                            Background="#A982F4" Foreground="#180D29" FontWeight="SemiBold"
                            Padding="15,9" Margin="12,0,0,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="1  ROBLOX LOGIN &amp; IDENTITY" Foreground="#C3A1FF"
                                   FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock x:Name="LoginStatusText"
                                   Text="Choose a browser below, then open Roblox login."
                                   Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>
                <DockPanel Margin="0,0,0,9">
                    <Button x:Name="VerifyOAuthButton" DockPanel.Dock="Right"
                            Content="✓ Connect verified Roblox account"
                            Click="VerifyOAuth_Click" Padding="14,9" FontSize="11"
                            Background="#46305F" ToolTip="Requires an OAuth app Client ID; confirms the username and User ID with Roblox, rather than guessing from the browser."/>
                    <TextBlock x:Name="OAuthIdentityStatus"
                               Text="Opening an ordinary Roblox webpage does not send your identity back to Viora."
                               Foreground="{StaticResource Muted}" FontSize="10"
                               VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0"/>
                </DockPanel>
                <Expander x:Name="OAuthSetupExpander" Header="One-time setup: official Roblox OAuth Client ID"
                          Foreground="#C8A6FF" Margin="0,0,0,9">
                    <StackPanel Margin="0,9,0,6">
                        <TextBlock Text="Register a Roblox OAuth app with openid + profile permissions and the exact redirect URL shown below. Paste its PUBLIC Client ID, never a Client Secret."
                                   TextWrapping="Wrap" Foreground="{StaticResource Muted}"
                                   FontSize="10" Margin="0,0,0,6"/>
                        <TextBlock Text="http://localhost:39141/oauth/callback/"
                                   Foreground="#D4B4FF" FontSize="11"
                                   Margin="0,0,0,7"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Save Client ID"
                                    Click="SaveOAuthClient_Click" Padding="12,7"
                                    Margin="7,0,0,0" FontSize="11"/>
                            <Button DockPanel.Dock="Right" Content="Roblox Creator Dashboard"
                                    Click="OpenOAuthRegistration_Click" Padding="12,7"
                                    Margin="7,0,0,0" FontSize="11"/>
                            <TextBox x:Name="OAuthClientIdInput" Height="29" MaxLength="40"
                                     VerticalContentAlignment="Center" FontSize="12"/>
                        </DockPanel>
                    </StackPanel>
                </Expander>
                <Border BorderThickness="0,0,0,1" BorderBrush="#413050" Margin="0,0,0,10"/>
                <TextBlock Text="2  OPTIONAL: CHANGE THE ACCOUNT LABEL / GAME" Foreground="#C3A1FF"
                           FontSize="11" FontWeight="SemiBold" Margin="0,0,0,9"/>
                <Grid Margin="0,0,0,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="ACCOUNT LABEL (EDIT IF WANTED)" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,0,0,4"/>
                        <TextBox x:Name="UsernameInput" MaxLength="20" Height="28"
                                 ToolTip="An account label, not proof of who is signed in"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="GAME PLACE ID (OPTIONAL)" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,0,0,4"/>
                        <TextBox x:Name="PlaceInput" Height="28"
                                 ToolTip="Roblox numeric place ID or a www.roblox.com/games/ link"/>
                    </StackPanel>
                </Grid>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="BROWSER" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,0,0,4"/>
                        <ComboBox x:Name="BrowserInput" Height="29" SelectedIndex="0">
                            <ComboBoxItem Content="Microsoft Edge" Tag="Edge"/>
                            <ComboBoxItem Content="Google Chrome" Tag="Chrome"/>
                            <ComboBoxItem Content="Brave Browser" Tag="Brave"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="BROWSER PROFILE FOLDER" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,0,0,4"/>
                        <ComboBox x:Name="ProfileInput" Height="29" IsEditable="True"
                                  ToolTip="Use 'Default', 'Profile 1', 'Profile 2', etc. You can type higher profile folder numbers."/>
                    </StackPanel>
                </Grid>
                <Expander x:Name="OptionalDetailsExpander" Header="Account identity, nickname, group and tags (optional)"
                          Foreground="#C8A6FF" Margin="0,0,0,9">
                    <StackPanel Margin="0,9,0,5">
                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="REAL ROBLOX USERNAME (PUBLIC LOOKUP)" Foreground="{StaticResource Muted}"
                                           FontSize="10" Margin="0,0,0,4"/>
                                <TextBox x:Name="RobloxUsernameInput" Height="28" MaxLength="20"
                                         ToolTip="Public profile lookup only. This doesn't verify who is signed in to the browser."/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="CUSTOM NICKNAME / DISPLAY NAME" Foreground="{StaticResource Muted}"
                                           FontSize="10" Margin="0,0,0,4"/>
                                <TextBox x:Name="AliasInput" Height="28" MaxLength="48"
                                         ToolTip="Overrides the Roblox display name shown in the Manager, without changing it on Roblox."/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="GROUP" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,0,0,4"/>
                                <TextBox x:Name="GroupInput" Height="28" MaxLength="40"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="TAGS (COMMA-SEPARATED)" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,0,0,4"/>
                                <TextBox x:Name="TagsInput" Height="28" MaxLength="140"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="PRIVATE NOTE (STORED ONLY IN LOCAL SETTINGS)"
                                   Foreground="{StaticResource Muted}" FontSize="10" Margin="0,0,0,4"/>
                        <TextBox x:Name="NotesInput" Height="50" MaxLength="500"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                        <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                            <CheckBox x:Name="FavoriteInput" Content="★ Favorite" Margin="0,0,22,0"
                                      Foreground="#EDDCFF" VerticalAlignment="Center"/>
                            <CheckBox x:Name="PinnedInput" Content="📌 Pin at top"
                                      Foreground="#EDDCFF" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Roblox display names and avatars come from PUBLIC profile APIs; they do not prove this browser is signed into that account."
                                   Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Expander>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Clear selection" Click="Clear_Click"
                            Margin="8,0,0,0"/>
                    <Button DockPanel.Dock="Right" x:Name="SaveButton" Content="Save account"
                            Background="#A982F4" Foreground="#180D29"
                            Click="Save_Click" Padding="18,9"/>
                    <TextBlock x:Name="SaveMessage" Foreground="{StaticResource Muted}" FontSize="11"
                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Background="#191222" CornerRadius="12" Padding="14" Margin="0,0,0,12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="SAVED ACCOUNTS" FontSize="11"
                           FontWeight="SemiBold" Foreground="#C3A1FF" Margin="0,0,0,8"/>
                <TextBlock x:Name="EmptyText" DockPanel.Dock="Top"
                           Text="No accounts saved. Click Open Roblox login to automatically save an account slot."
                           Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                           Margin="0,5,0,9"/>
                <ListBox x:Name="AccountList" BorderThickness="0" Background="Transparent"
                         SelectionChanged="AccountList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#3B2C4F" BorderThickness="0,0,0,1"
                                    Padding="5,11">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Username}" FontWeight="SemiBold"
                                                   FontSize="14" Foreground="#F2EAFF"/>
                                        <TextBlock Text="{Binding Detail}" FontSize="11"
                                                   Foreground="#C1B1D4" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Button Content="Sign in / Roblox" Tag="{Binding}" Click="OpenAccount_Click"
                                                Margin="0,0,7,0" Padding="11,8"/>
                                        <Button Content="▶ Play game" Tag="{Binding}" Click="OpenGame_Click"
                                                Margin="0,0,7,0" Padding="11,8"/>
                                        <Button Content="Remove" Tag="{Binding}" Click="Remove_Click"
                                                Padding="11,8"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
        <TextBlock Grid.Row="3" Foreground="{StaticResource Muted}"
                   FontSize="11" TextWrapping="Wrap"
                   Text="Official OAuth links a Roblox identity to this shortcut; it does not grant Roblox Player session control. Browser cookies stay in the browser. Only public identity metadata is saved by Viora."/>
    </Grid>
</Window>