<Window x:Class="VioraManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Viora Manager — Accounts"
        Width="1050" Height="770" MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="#0D0915" Foreground="#F2EAFF">
    <Grid Background="#0D0915" Margin="19">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Width="46" Height="46" Background="#322047" CornerRadius="11" Margin="0,0,12,0">
                <TextBlock Text="▱" FontSize="29" Foreground="#C3A1FF"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Viora Manager" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="Your Roblox accounts and launch tools"
                           Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="AccountsTab" Content="Accounts" Click="AccountsHome_Click"
                        Background="#A982F4" Foreground="#180D29" FontWeight="SemiBold"
                        Margin="0,0,7,0" Padding="14,8"/>
                <Button x:Name="InstancesTab" Content="Instances &amp; Tools" Click="InstancesHome_Click"
                        Background="#39274D" Margin="0,0,9,0" Padding="14,8"/>
                <Border Background="#292033" CornerRadius="12" Padding="9,5" VerticalAlignment="Center">
                    <TextBlock x:Name="ManagerVersionText" Text="Preview" Foreground="#CFBBEB" FontSize="11"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Account Manager is always the starting page. The original instance
             controls remain available through the second navigation tab. -->
        <Grid x:Name="AccountsHome" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,12">
                <Border Background="{StaticResource Panel}" Padding="12,9" CornerRadius="10" Margin="0,0,5,0">
                    <StackPanel>
                        <TextBlock Text="SAVED ACCOUNTS" FontSize="10" Foreground="{StaticResource Muted}"/>
                        <TextBlock x:Name="SavedAccountCount" Text="0 saved" FontSize="17" FontWeight="SemiBold"
                                   Foreground="#D7B9FF" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource Panel}" Padding="12,9" CornerRadius="10" Margin="5,0">
                    <StackPanel>
                        <TextBlock Text="PUBLIC PROFILES LINKED" FontSize="10" Foreground="{StaticResource Muted}"/>
                        <TextBlock x:Name="LinkedAccountCount" Text="0" FontSize="17" FontWeight="SemiBold"
                                   Foreground="#D7B9FF" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource Panel}" Padding="12,9" CornerRadius="10" Margin="5,0,0,0">
                    <StackPanel>
                        <TextBlock Text="SELECTED" FontSize="10" Foreground="{StaticResource Muted}"/>
                        <TextBlock x:Name="SelectedAccountCount" Text="0" FontSize="17" FontWeight="SemiBold"
                                   Foreground="#D7B9FF" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Grid.Row="1" Background="#1C142A" BorderBrush="#51336C"
                    BorderThickness="1" CornerRadius="11" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Your Accounts" Foreground="#D4B4FF"
                                       FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="Official Roblox avatars and public display names where a username is linked. Custom nicknames always take priority."
                                       Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="↻ Refresh profiles"
                                Click="RefreshPublicProfiles_Click" Margin="8,0,7,0"
                                Padding="11,7" FontSize="11"
                                ToolTip="Look up public Roblox profile names and avatars. Does not inspect browser login."/>
                        <Button Grid.Column="2" Content="＋ Add an Account"
                                Click="AddAccount_Click" Background="#A982F4" Foreground="#180D29"
                                Padding="13,8" FontWeight="SemiBold" FontSize="12"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="155"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="AccountSearchInput" Grid.Column="0"
                                 ToolTip="Search usernames, nicknames, groups, notes and tags"
                                 Height="30" FontSize="12" Padding="9,6"
                                 VerticalContentAlignment="Center" TextChanged="AccountSearch_Changed"/>
                        <ComboBox x:Name="AccountGroupFilter" Grid.Column="2" Height="30"
                                  SelectionChanged="AccountFilter_Changed" FontSize="11">
                            <ComboBoxItem Content="All groups" Tag="" IsSelected="True"/>
                        </ComboBox>
                        <CheckBox x:Name="AccountFavoriteFilter" Grid.Column="4"
                                  Content="★ Favourites" Foreground="#E7D2FF"
                                  VerticalAlignment="Center" Margin="0,0,8,0"
                                  Checked="AccountFilter_Changed" Unchecked="AccountFilter_Changed"/>
                        <CheckBox x:Name="AccountPinnedFilter" Grid.Column="5"
                                  Content="📌 Pinned" Foreground="#E7D2FF"
                                  VerticalAlignment="Center"
                                  Checked="AccountFilter_Changed" Unchecked="AccountFilter_Changed"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="GAME / SUBPLACE ID"
                                   FontSize="10" Foreground="{StaticResource Muted}"
                                   VerticalAlignment="Center" Margin="0,0,9,0"/>
                        <TextBox Grid.Column="1" x:Name="QuickPlaceInput"
                                 Height="29" FontSize="12" Padding="9,5"
                                 ToolTip="Numeric Place ID or Roblox game link. Overrides saved game for launches."/>
                        <TextBox Grid.Column="3" x:Name="QuickJobInput"
                                 Height="29" FontSize="12" Padding="9,5"
                                 ToolTip="Optional running server Job ID (GUID). Leave blank for an automatic public server."
                                 MaxLength="40"/>
                    </Grid>
                    <DockPanel Margin="0,7,0,0">
                        <Button DockPanel.Dock="Right" Content="Browse / random servers"
                                Click="BrowseServers_Click" FontSize="11" Padding="10,6"
                                Margin="10,0,0,0"
                                ToolTip="Use Roblox's public server list; choose a server Job ID."/>
                        <TextBlock Text="Optional server Job ID on the right. Server joins may fail if full, and client account selection is not guaranteed."
                                   Foreground="{StaticResource Muted}" FontSize="10"
                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </DockPanel>
                </StackPanel>
            </Border>
            <Border Grid.Row="2" Background="#191222" CornerRadius="11" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" x:Name="EmptyAccountsText"
                               Foreground="{StaticResource Muted}" FontSize="12"
                               Text="No accounts saved. Press Add an Account to sign in on Roblox."
                               TextWrapping="Wrap" Margin="6,15"/>
                    <ListBox x:Name="ConnectedAccountsList" Background="Transparent" BorderThickness="0"
                             SelectionMode="Extended" SelectionChanged="AccountsSelection_Changed"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#251B32" CornerRadius="10" Padding="12,10" Margin="0,0,0,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="54"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="45" Height="45" VerticalAlignment="Center">
                                            <Border Background="#48315F" CornerRadius="23">
                                                <TextBlock Text="{Binding AvatarInitial}"
                                                           Foreground="#DEC5FF" FontSize="20"
                                                           FontWeight="SemiBold" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <Border CornerRadius="23" ClipToBounds="True">
                                                <Image Source="{Binding AvatarImage}" Stretch="UniformToFill"
                                                       Width="45" Height="45"/>
                                            </Border>
                                        </Grid>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,8,0">
                                            <TextBlock Text="{Binding DisplayLabel}" FontSize="15"
                                                       FontWeight="SemiBold" Foreground="#F5EBFF"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding SecondaryLine}"
                                                       Foreground="#CBB9E4" FontSize="11" Margin="0,3,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}"
                                                       FontSize="10" TextTrimming="CharacterEllipsis"
                                                       Margin="0,3,0,0" ToolTip="{Binding Detail}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Tag="{Binding}" Content="Edit" Click="EditSavedAccount_Click"
                                                    Margin="0,0,6,0" Padding="11,7" FontSize="11"/>
                                            <Button Tag="{Binding}" Content="Sign in" Click="SavedAccountLogin_Click"
                                                    Margin="0,0,6,0" Padding="11,7" FontSize="11"/>
                                            <Button Tag="{Binding}" Content="▶ Play" Click="SavedAccountPlay_Click"
                                                    Background="#A982F4" Foreground="#180D29"
                                                    Padding="13,7" FontSize="11" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <StackPanel Grid.Row="3">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Select all" Click="SelectAllAccounts_Click"
                            Padding="12,8" Margin="0,0,7,0" FontSize="11"/>
                    <Button Grid.Column="1" Content="Clear" Click="ClearAccountSelection_Click"
                            Padding="12,8" Margin="0,0,7,0" FontSize="11"/>
                    <Button Grid.Column="3" Content="Export list" Click="ExportAccounts_Click"
                            Padding="11,8" Margin="0,0,7,0" FontSize="11"
                            ToolTip="Save non-secret account labels and settings. Does not export browser logins."/>
                    <Button Grid.Column="4" x:Name="CancelBatchButton" Content="Stop queue"
                            Click="CancelLaunchQueue_Click" IsEnabled="False" Padding="11,8"
                            Margin="0,0,7,0" FontSize="11"/>
                    <Button Grid.Column="5" x:Name="LaunchSelectedButton" Content="▶ Launch selected"
                            Click="LaunchSelected_Click" Padding="15,8" FontSize="12"
                            FontWeight="SemiBold" Background="#A982F4" Foreground="#180D29"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                    <Button Content="Import list" Click="ImportAccounts_Click" Padding="11,6"
                            FontSize="11" Margin="0,0,8,0"
                            ToolTip="Merge a metadata-only JSON account list into Viora. No browser cookies imported."/>
                    <Button Content="Launch history" Click="LaunchHistory_Click" Padding="11,6"
                            FontSize="11" Margin="0,0,8,0"/>
                    <TextBlock Text="Launch delay:" Foreground="{StaticResource Muted}"
                               VerticalAlignment="Center" FontSize="11" Margin="12,0,7,0"/>
                    <ComboBox x:Name="LaunchDelayInput" Width="85" Height="28" SelectedIndex="2"
                              FontSize="11" ToolTip="Seconds between launches in a queue">
                        <ComboBoxItem Content="2 sec" Tag="2"/>
                        <ComboBoxItem Content="3 sec" Tag="3"/>
                        <ComboBoxItem Content="4 sec" Tag="4"/>
                        <ComboBoxItem Content="5 sec" Tag="5"/>
                        <ComboBoxItem Content="10 sec" Tag="10"/>
                    </ComboBox>
                </StackPanel>
                <TextBlock x:Name="AccountLaunchStatus" Foreground="{StaticResource Muted}"
                           FontSize="10" TextWrapping="Wrap" Margin="0,7,0,0"
                           Text="Browser sessions are separate, but Roblox Player may still use a different account."/>
            </StackPanel>
        </Grid>

        <!-- Existing Manager tools, unchanged behaviour, moved to secondary view. -->
        <Grid x:Name="InstancesHome" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,13">
                <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="14" Margin="0,0,5,0">
                    <StackPanel>
                        <TextBlock Text="Instances" Foreground="{StaticResource Muted}" FontSize="11"/>
                        <TextBlock x:Name="InstanceCount" Text="0" FontWeight="SemiBold" FontSize="21" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="14" Margin="5,0">
                    <StackPanel>
                        <TextBlock Text="Memory" Foreground="{StaticResource Muted}" FontSize="11"/>
                        <TextBlock x:Name="MemoryText" Text="0 MB" FontWeight="SemiBold" FontSize="21" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="14" Margin="5,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Status" Foreground="{StaticResource Muted}" FontSize="11"/>
                        <TextBlock x:Name="StatusText" Text="Idle" FontWeight="SemiBold" FontSize="21" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
            <Border Grid.Row="1" Background="#1C142A" BorderBrush="#51336C"
                    BorderThickness="1" CornerRadius="11" Padding="15,12" Margin="0,0,0,13">
                <StackPanel>
                    <CheckBox x:Name="MultiInstanceToggle" Click="MultiInstanceToggle_Click"
                              Foreground="#E8D9FF" FontWeight="SemiBold"
                              Content="Enable experimental multi-instance mode"/>
                    <TextBlock x:Name="ExperimentStatus" Foreground="{StaticResource Muted}"
                               FontSize="11" Margin="20,6,0,0" TextWrapping="Wrap"
                               Text="Off by default. Roblox does not officially support simultaneous Player clients."/>
                </StackPanel>
            </Border>
            <Border Grid.Row="2" Background="#191222" CornerRadius="11" Padding="16" Margin="0,0,0,12">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="Detected Roblox Player windows" Foreground="#D4B4FF"
                                   FontSize="14" FontWeight="SemiBold"/>
                        <Button Content="Refresh" Click="Refresh_Click" HorizontalAlignment="Right" Padding="11,4"/>
                    </Grid>
                    <TextBlock x:Name="EmptyInstancesText" DockPanel.Dock="Top"
                               Text="No Roblox Player windows detected."
                               Foreground="{StaticResource Muted}" FontSize="12" Margin="0,14,0,0"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="InstanceList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#3B2C4F" BorderThickness="0,0,0,1" Padding="0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="15"/>
                                                <TextBlock Text="{Binding GameName}" FontWeight="SemiBold"
                                                           Foreground="#C6A5FF" FontSize="12" Margin="0,4,0,0"/>
                                                <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}"
                                                           FontSize="11" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="Running" Foreground="#62D6A3"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Content="＋ Open Roblox" Click="OpenRoblox_Click" Margin="0,0,6,0"
                        Background="#A982F4" Foreground="#180D29" FontWeight="SemiBold"/>
                <Button Grid.Column="1" Content="Edit accounts" Click="Accounts_Click" Margin="3,0"/>
                <Button Grid.Column="2" Content="Manage windows" Click="ManageWindows_Click" Margin="6,0,0,0"/>
            </Grid>
        </Grid>
        <TextBlock Grid.Row="2"
                   Text="Official Roblox account identity cannot be inferred from a browser session. Preview builds are not a guarantee of multi-instance support."
                   Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="10"
                   Margin="0,9,0,0"/>
    </Grid>
</Window>