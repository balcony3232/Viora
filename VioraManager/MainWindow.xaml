<Window x:Class="VioraManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Viora Manager — Instance &amp; Session Control"
        Width="980" Height="700" MinWidth="700" MinHeight="560"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="#0D0915" Foreground="#F2EAFF">
    <Grid Background="#0D0915">
      <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Width="46" Height="46" Background="#322047" CornerRadius="10" Margin="0,0,13,0">
                <TextBlock Text="▱" Foreground="#C3A1FF" FontSize="29" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Viora Manager" FontWeight="SemiBold" FontSize="19"/>
                <TextBlock Text="Instance &amp; Session Control" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0"/>
            </StackPanel>
            <Border Grid.Column="2" Padding="10,5" Background="#292033" CornerRadius="12" VerticalAlignment="Center">
                <TextBlock Text="Early Preview" FontSize="11" Foreground="#CFBBEB"/>
            </Border>
        </Grid>
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,14">
            <Border Background="{StaticResource Panel}" CornerRadius="11" Padding="14" Margin="0,0,5,0">
                <StackPanel><TextBlock Text="Instances" Foreground="{StaticResource Muted}" FontSize="11"/>
                    <TextBlock x:Name="InstanceCount" Text="0" FontSize="21" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
            </Border>
            <Border Background="{StaticResource Panel}" CornerRadius="11" Padding="14" Margin="5,0">
                <StackPanel><TextBlock Text="Memory" Foreground="{StaticResource Muted}" FontSize="11"/>
                    <TextBlock x:Name="MemoryText" Text="0 MB" FontSize="21" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
            </Border>
            <Border Background="{StaticResource Panel}" CornerRadius="11" Padding="14" Margin="5,0,0,0">
                <StackPanel><TextBlock Text="Status" Foreground="{StaticResource Muted}" FontSize="11"/>
                    <TextBlock x:Name="StatusText" Text="Idle" Foreground="#DCC8F7" FontSize="21" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
            </Border>
        </UniformGrid>
        <Border Grid.Row="2" Background="#1C142A" BorderBrush="#51336C" BorderThickness="1"
                CornerRadius="11" Padding="15,12" Margin="0,0,0,14">
            <StackPanel>
                <CheckBox x:Name="MultiInstanceToggle" Click="MultiInstanceToggle_Click"
                          Foreground="#E8D9FF" FontWeight="SemiBold" FontSize="13"
                          Content="Enable experimental multi-instance mode"/>
                <TextBlock x:Name="ExperimentStatus"
                           Foreground="#B9A9CC" FontSize="11" Margin="20,7,0,0" TextWrapping="Wrap"
                           Text="Off by default. Applies only while Viora Manager stays open. Roblox does not officially support simultaneous Player clients."/>
            </StackPanel>
        </Border>
        <Border Grid.Row="3" Background="#191222" CornerRadius="11" Padding="16" Margin="0,0,0,14">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,9">
                    <TextBlock Text="Detected Roblox Player windows" Foreground="{StaticResource Muted}" FontSize="12"/>
                    <Button Content="Refresh" Click="Refresh_Click" HorizontalAlignment="Right" Padding="11,4" FontSize="11"/>
                </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="InstanceList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#3B2C4F" BorderThickness="0,0,0,1" Padding="0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#342248" Width="46" Height="46" CornerRadius="10" Margin="0,0,14,0">
                                            <TextBlock Text="♧" FontSize="23" Foreground="#BE9BFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="16"/>
                                            <TextBlock Text="{Binding GameName}" FontWeight="SemiBold" FontSize="13"
                                                       Foreground="#C6A5FF" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"
                                                       ToolTip="{Binding GameName}"/>
                                            <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Background="#17352B" CornerRadius="12" Padding="10,5" VerticalAlignment="Center">
                                            <TextBlock Text="Running" FontSize="11" Foreground="#62D6A3"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button Content="＋  Open Roblox" Background="#A982F4" Foreground="#180D29" FontWeight="SemiBold" Margin="0,0,5,0" Click="OpenRoblox_Click"/>
            <Button Grid.Column="1" Content="Manage windows" Background="#39274D" FontWeight="SemiBold" Margin="5,0,0,0" Click="ManageWindows_Click"/>
        </Grid>
        <TextBlock Grid.Row="5" Text="Experimental compatibility does not modify Roblox files, but simultaneous Player support and account safety are not guaranteed."
                   Foreground="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap"/>
      </Grid>
    </Grid>
</Window>