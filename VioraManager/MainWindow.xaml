<Window x:Class="VioraManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Viora Manager — Instance &amp; Session Control"
        Width="980" Height="770" MinWidth="730" MinHeight="610"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="#0D0915" Foreground="#F2EAFF">
    <Grid Background="#0D0915">
      <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Width="46" Height="46" Background="#322047" CornerRadius="10" Margin="0,0,13,0">
                <TextBlock Text="▱" Foreground="#C3A1FF" FontSize="29" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Viora Manager" FontWeight="SemiBold" FontSize="19"/>
                <TextBlock Text="Instance &amp; Session Control" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0"/>
            </StackPanel>
            <Border Grid.Column="2" Padding="10,5" Background="#292033" CornerRadius="12" VerticalAlignment="Center">
                <TextBlock x:Name="ManagerVersionText" Text="v1.3 Preview" FontSize="11" Foreground="#CFBBEB"/>
            </Border>
        </Grid>
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,14">
            <Border Background="{StaticResource Panel}" CornerRadius="11" Padding="14" Margin="0,0,5,0">
                <StackPanel><TextBlock Text="Instances" Foreground="{StaticResource Muted}" FontSize="11"/>
                    <TextBlock x:Name="InstanceCount" Text="0" FontSize="21" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
            </Border>
            <Border Background="{StaticResource Panel}" CornerRadius="11" Padding="14" Margin="5,0">
                <StackPanel><TextBlock Text="Memory" Foreground="{StaticResource Muted}" FontSize="11"/>
                    <TextBlock x:Name="MemoryText" Text="0 MB" FontSize="21" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
            </Border>
            <Border Background="{StaticResource Panel}" CornerRadius="11" Padding="14" Margin="5,0,0,0">
                <StackPanel><TextBlock Text="Status" Foreground="{StaticResource Muted}" FontSize="11"/>
                    <TextBlock x:Name="StatusText" Text="Idle" Foreground="#DCC8F7" FontSize="21" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
            </Border>
        </UniformGrid>
        <Border Grid.Row="2" Background="#1C142A" BorderBrush="#51336C" BorderThickness="1"
                CornerRadius="11" Padding="15,12" Margin="0,0,0,14">
            <StackPanel>
                <CheckBox x:Name="MultiInstanceToggle" Click="MultiInstanceToggle_Click"
                          Foreground="#E8D9FF" FontWeight="SemiBold" FontSize="13"
                          Content="Enable experimental multi-instance mode"/>
                <TextBlock x:Name="ExperimentStatus"
                           Foreground="#B9A9CC" FontSize="11" Margin="20,7,0,0" TextWrapping="Wrap"
                           Text="Off by default. Applies only while Viora Manager stays open. Roblox does not officially support simultaneous Player clients."/>
            </StackPanel>
        </Border>
        <Grid Grid.Row="3" Margin="0,0,0,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="130"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#1C142A" BorderBrush="#51336C" BorderThickness="1"
                    CornerRadius="11" Padding="14,12" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Connected Accounts" FontWeight="SemiBold" FontSize="15"
                                       Foreground="#D4B4FF" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SavedAccountCount" Text="0 saved" FontSize="11" Margin="12,1,0,0"
                                       Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="＋ Add an Account" Click="AddAccount_Click"
                                Padding="10,7" FontSize="11" Background="#38264B"/>
                    </Grid>
                    <Grid Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="GAME / SUBPLACE ID" Foreground="{StaticResource Muted}"
                                   FontSize="10" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBox Grid.Column="1" x:Name="QuickPlaceInput" Height="28" VerticalContentAlignment="Center"
                                 ToolTip="Optional override for all Play buttons. Enter a Place ID or official Roblox game URL; blank uses each account's saved game."
                                 FontSize="12" Padding="8,4"/>
                    </Grid>
                    <TextBlock x:Name="EmptyAccountsText"
                               Text="No saved accounts yet. Click Add accounts to assign a separate browser profile to each Roblox username."
                               Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,4"/>
                    <ScrollViewer Height="152" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ConnectedAccountsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#413050" BorderThickness="0,0,0,1" Padding="2,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Username}" FontSize="13" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" Foreground="#F2EAFF"/>
                                                <TextBlock Text="{Binding Detail}" FontSize="10"
                                                           TextTrimming="CharacterEllipsis" Foreground="{StaticResource Muted}"
                                                           Margin="0,3,0,0" ToolTip="{Binding Detail}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Sign in" FontSize="11" Padding="12,7"
                                                    Background="#38264B" Margin="8,0,7,0"
                                                    Tag="{Binding}" Click="SavedAccountLogin_Click"
                                                    ToolTip="Open official Roblox website in this browser profile"/>
                                            <Button Grid.Column="2" Content="▶ Play" FontSize="11" Padding="13,7"
                                                    FontWeight="SemiBold" Background="#A982F4" Foreground="#180D29"
                                                    Tag="{Binding}" Click="SavedAccountPlay_Click"
                                                    ToolTip="Try to launch the selected Place ID in the saved browser profile; Roblox controls the actual account/session"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="AccountLaunchStatus" Text="Play uses the official Roblox game-start link. Check the signed-in Roblox Player account; multiple clients aren't guaranteed."
                               Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="10" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        <Border Grid.Row="1" Background="#191222" CornerRadius="11" Padding="16" Margin="0,0,0,14">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,9">
                    <TextBlock Text="Detected Roblox Player windows" Foreground="{StaticResource Muted}" FontSize="12"/>
                    <Button Content="Refresh" Click="Refresh_Click" HorizontalAlignment="Right" Padding="11,4" FontSize="11"/>
                </Grid>
                <TextBlock x:Name="EmptyInstancesText" DockPanel.Dock="Top" Text="No Roblox Player windows detected. Open a game using Roblox to see its session here."
                           Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,18,0,0" FontSize="13"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="InstanceList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#3B2C4F" BorderThickness="0,0,0,1" Padding="0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#342248" Width="46" Height="46" CornerRadius="10" Margin="0,0,14,0">
                                            <TextBlock Text="♧" FontSize="23" Foreground="#BE9BFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="16"/>
                                            <TextBlock Text="{Binding GameName}" FontWeight="SemiBold" FontSize="13"
                                                       Foreground="#C6A5FF" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"
                                                       ToolTip="{Binding GameName}"/>
                                            <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Background="#17352B" CornerRadius="12" Padding="10,5" VerticalAlignment="Center">
                                            <TextBlock Text="Running" FontSize="11" Foreground="#62D6A3"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
        </Grid>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Content="＋  Open Roblox" Background="#A982F4" Foreground="#180D29"
                    FontWeight="SemiBold" Margin="0,0,6,0" Click="OpenRoblox_Click"/>
            <Button Grid.Column="1" Content="♧  Edit accounts" Background="#39274D"
                    FontWeight="SemiBold" Margin="3,0,3,0" Click="Accounts_Click"
                    ToolTip="Save Roblox account shortcuts in separate browser profiles — never stores Roblox passwords"/>
            <Button Grid.Column="2" Content="Manage windows" Background="#39274D"
                    FontWeight="SemiBold" Margin="6,0,0,0" Click="ManageWindows_Click"/>
        </Grid>
        <TextBlock Grid.Row="5" Text="Experimental compatibility does not modify Roblox files, but simultaneous Player support and account safety are not guaranteed."
                   Foreground="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap"/>
      </Grid>
    </Grid>
</Window>