<Window x:Class="VioraManager.ServerBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Viora Manager — Public Servers" Width="690" Height="560"
        MinWidth="600" MinHeight="480" WindowStartupLocation="CenterOwner"
        Background="#0D0915" Foreground="#F2EAFF">
    <Grid Margin="19">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="Public Server Browser" Foreground="#C9A5FF"
                       FontSize="21" FontWeight="SemiBold"/>
            <TextBlock x:Name="PlaceDescription" Text="A public list of Roblox servers for the selected Place ID."
                       Margin="0,5,0,0" Foreground="{StaticResource Muted}"
                       TextWrapping="Wrap" FontSize="11"/>
        </StackPanel>
        <Border Grid.Row="1" Background="{StaticResource Panel}" Padding="12"
                CornerRadius="11" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Min players" VerticalAlignment="Center"
                           Foreground="{StaticResource Muted}" Margin="0,0,9,0"/>
                <TextBox x:Name="MinimumInput" Grid.Column="1" Text="0" Height="29"
                         VerticalContentAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="Max players" VerticalAlignment="Center"
                           Foreground="{StaticResource Muted}" Margin="15,0,9,0"/>
                <TextBox x:Name="MaximumInput" Grid.Column="3" Text="1000" Height="29"
                         VerticalContentAlignment="Center"/>
                <Button Grid.Column="5" Content="Refresh servers" Click="Refresh_Click" Margin="12,0,0,0"/>
            </Grid>
        </Border>
        <Border Grid.Row="2" Background="#191222" Padding="10" CornerRadius="11">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" x:Name="ResultStatus" Foreground="{StaticResource Muted}"
                           Text="Loading public servers..." FontSize="11" Margin="2,2,2,10" TextWrapping="Wrap"/>
                <ListBox x:Name="ServerList" Background="Transparent" BorderThickness="0"
                         SelectionMode="Single" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#292034" CornerRadius="8" Padding="10,9" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" Foreground="#F2EAFF" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Id}" Foreground="{StaticResource Muted}"
                                                   FontSize="10" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding PopulationLabel}"
                                               VerticalAlignment="Center" Foreground="#D7B9FF"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Server lists are partial and can change; a join may fail if the server fills or disappears."
                       Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap"
                       VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button Grid.Column="1" Content="Pick random" Click="Random_Click"
                    Margin="0,0,7,0" Padding="12,9"/>
            <Button Grid.Column="2" Content="Use selected server" Click="Use_Click"
                    Margin="0,0,7,0" Padding="12,9"
                    Background="#A982F4" Foreground="#180D29"/>
            <Button Grid.Column="3" Content="Cancel" Click="Cancel_Click" Padding="12,9"/>
        </Grid>
    </Grid>
</Window>